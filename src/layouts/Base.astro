---
import { sitePath, communityUrl } from '../lib/site-path';
import '../styles/global.css';
import '../styles/new-theme.css';
import '../styles/interior.css';
import '../styles/world-continuity.css';
import Icon from '../components/Icon.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title?: string; description?: string; active?: string; noindex?: boolean; }
const { title = 'Games, tools & experiments.', description = 'Liss Works 工程展厅：独立开发的游戏、Unity 工具、AI 应用、图形与算法实验。', active = '', noindex = false } = Astro.props;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="color-scheme" content="dark"/><meta name="theme-color" content="#080c14"/><meta name="description" content={description}/>{noindex && <meta name="robots" content="noindex"/>}<meta property="og:site_name" content="Liss Works · 工程展厅"/><meta property="og:title" content={`${title} · Liss Works`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{canonical && <><link rel="canonical" href={canonical}/><meta property="og:url" content={canonical}/></>}<title>{title} · Liss Works</title><link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')}/><link rel="preload" href={sitePath('/fonts/rajdhani-semibold.woff2')} as="font" type="font/woff2" crossorigin/><slot name="head"/></head>
<body><a class="skip-link" href="#main">跳到主要内容</a>
 <header class="site-header shell"><a class="brand" href={sitePath('/')} aria-label="Liss Works 工程展厅首页" title="Liss Works · 工程展厅"><svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true"><path d="m16 1 15 15-15 15L1 16Z" fill="currentColor"/><path d="m16 9 7 7-7 7-7-7Z" fill="#080c14"/></svg>Liss Works</a>
 <nav aria-label="主要导航"><a href={sitePath('/projects/')} aria-current={active === 'projects' ? 'page' : undefined}>工程</a><a href={sitePath('/lab/')} aria-current={active === 'lab' ? 'page' : undefined}>交互实验</a><a href={communityUrl}>交流</a><a href={sitePath('/about/')} aria-current={active === 'about' ? 'page' : undefined}>关于</a><a class="github-nav" href="https://github.com/heroliss" target="_blank" rel="noreferrer" aria-label="Liss 的 GitHub（新窗口）"><Icon name="github" size={21}/><span>GitHub</span></a></nav></header>
 <main id="main"><slot/></main>
 <SiteFooter/>
 <dialog class="lightbox" aria-label="截图查看器"><div class="lightbox__toolbar"><p class="lightbox__title"></p><button type="button" class="icon-button lightbox__close" aria-label="关闭截图"><Icon name="close" size={24}/></button></div><div class="lightbox__stage"><button type="button" class="icon-button lightbox__prev" aria-label="上一张截图"><Icon name="back" size={25}/></button><div class="lightbox__image-slot"></div><button type="button" class="icon-button lightbox__next" aria-label="下一张截图"><Icon name="chevron" size={25}/></button></div><div class="lightbox__footer"><p class="lightbox__caption"></p><span class="lightbox__count" aria-live="polite"></span><a class="text-link lightbox__original" href={sitePath('/')} target="_blank" rel="noreferrer">打开大图 <Icon size={16}/></a></div></dialog>
 <script>import '../scripts/site'; import '../scripts/motion'; import '../scripts/site-continuity';</script>
</body></html>

