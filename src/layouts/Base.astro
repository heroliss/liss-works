---
import { sitePath, communityUrl } from '../lib/site-path';
import { serializeJsonForHtml } from '../lib/safe-json';
import '../styles/global.css';
import '../styles/new-theme.css';
import '../styles/interior.css';
import '../styles/world-continuity.css';
import Icon from '../components/Icon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/site-chrome.css';
import '../styles/lightbox.css';
import { getProject } from '../data/projects';
import type { GalleryImage } from '../data/types';
type ShareImage = Pick<GalleryImage, 'src' | 'width' | 'height' | 'alt'>;
interface Props {
  title?: string;
  description?: string;
  active?: string;
  noindex?: boolean;
  image?: ShareImage;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = 'Games, tools & experiments.',
  description = 'Liss Works 工程展厅：独立开发的游戏、Unity 工具、AI 应用、图形与算法实验。',
  active = '',
  noindex = false,
  image = getProject('glass-atoll')!.cover,
  jsonLd,
} = Astro.props;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Link previews need an absolute image URL, so it is only emitted for production builds with SITE_URL.
const shareImage = Astro.site && !noindex ? new URL(sitePath(image.src), Astro.site).href : undefined;
// Visitor analytics (served by the community). Production builds only; LISS_ANALYTICS_SRC overrides for local tests.
const analyticsOverride = (globalThis as { process?: { env?: Record<string, string | undefined> } }).process?.env?.LISS_ANALYTICS_SRC;
const analyticsSrc = analyticsOverride ?? (Astro.site ? `${communityUrl}static/liss-analytics.js` : '');
---
<!doctype html>
<html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="color-scheme" content="dark"/><meta name="theme-color" content="#080c14"/><meta name="referrer" content="strict-origin-when-cross-origin"/><meta name="description" content={description}/>{noindex && <meta name="robots" content="noindex"/>}<meta property="og:site_name" content="Liss Works · 工程展厅"/><meta property="og:title" content={`${title} · Liss Works`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="zh_CN"/>{canonical && <><link rel="canonical" href={canonical}/><meta property="og:url" content={canonical}/></>}{shareImage ? <><meta property="og:image" content={shareImage}/><meta property="og:image:width" content={String(image.width)}/><meta property="og:image:height" content={String(image.height)}/><meta property="og:image:alt" content={image.alt}/><meta name="twitter:card" content="summary_large_image"/></> : <meta name="twitter:card" content="summary"/>}<title>{title} · Liss Works</title><link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')}/><link rel="preload" href={sitePath('/fonts/rajdhani-semibold.woff2')} as="font" type="font/woff2" crossorigin/>{jsonLd && <script type="application/ld+json" set:html={serializeJsonForHtml(jsonLd)}></script>}<slot name="head"/>{analyticsSrc && <script is:inline async src={analyticsSrc} data-site="works"></script>}</head>
<body><a class="skip-link" href="#main">跳到主要内容</a>
 <header class="site-header shell" data-site-header><a class="brand" href={sitePath('/')} aria-label="返回 Liss Works 首页" title="返回 Liss Works 首页"><svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 2 30 16H16Z" fill="#fd8358"/><path d="M30 16 16 30V16Z" fill="#30aff8"/><path d="M16 30 2 16h14Z" fill="#e27ee8"/><path d="M2 16 16 2v14Z" fill="#c8ec60"/><path d="m16 10 6 6-6 6-6-6Z" fill="#080c14"/></svg><span>Liss Works</span></a>
 <nav aria-label="主要导航"><a class="home-nav" href={sitePath('/')} style="--tone:#c8ec60" aria-current={active === 'home' ? 'page' : undefined}>首页</a><a href={sitePath('/projects/')} style="--tone:#6ee8e3" aria-current={active === 'projects' ? 'page' : undefined}>工程库</a><a href={sitePath('/lab/')} style="--tone:#facf4e" aria-current={active === 'lab' ? 'page' : undefined}>交互实验</a><a class="about-nav" href={sitePath('/about/')} style="--tone:#e27ee8" aria-current={active === 'about' ? 'page' : undefined}>关于</a><a class="github-nav" href="https://github.com/heroliss" target="_blank" rel="noopener noreferrer" aria-label="Liss 的 GitHub（新窗口）"><Icon name="github" size={19}/></a><a class="community-nav" href={communityUrl}><Icon name="chat" size={16}/><span>交流</span></a></nav></header>
 <main id="main"><slot/></main>
 <SiteFooter/>
 <dialog class="lightbox" aria-label="截图查看器" data-zoomed="false"><div class="lightbox__toolbar"><p class="lightbox__title"></p><div class="lightbox__actions"><button type="button" class="lightbox__zoom" data-lightbox-zoom aria-pressed="false" aria-label="切换原尺寸缩放"><Icon name="expand" size={16}/><span data-lightbox-zoom-label>1:1 放大</span></button><button type="button" class="icon-button lightbox__close" aria-label="关闭截图"><Icon name="close" size={22}/></button></div></div><div class="lightbox__stage" data-lightbox-stage><button type="button" class="icon-button lightbox__prev" aria-label="上一张截图"><Icon name="back" size={24}/></button><div class="lightbox__image-slot" data-lightbox-slot></div><button type="button" class="icon-button lightbox__next" aria-label="下一张截图"><Icon name="chevron" size={24}/></button></div><div class="lightbox__footer"><p class="lightbox__caption"></p><span class="lightbox__hint" aria-hidden="true">← → 切换 · 双击缩放 · Esc 关闭</span><span class="lightbox__count" aria-live="polite"></span><a class="text-link lightbox__original" href={sitePath('/')} target="_blank" rel="noopener noreferrer">打开原图 <Icon size={15}/></a></div></dialog>
 <script>import '../scripts/site'; import '../scripts/site-chrome'; import '../scripts/motion'; import '../scripts/site-continuity';</script>
</body></html>
