---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MediaImage from '../components/MediaImage.astro';
import FrameworkDiagram from '../components/FrameworkDiagram.astro';
import { ANCHORS, EDGES, DESTINATIONS } from '../scripts/signal-field-data';
import { projects, getProject } from '../data/projects';
import { sitePath, communityUrl } from '../lib/site-path';
import '../styles/home-next.css';
import '../styles/expressive-home.css';
const framework = getProject('ssframework')!;
const dubforge = getProject('dubforge')!;
const outpost = getProject('outpost')!;
const nomad = getProject('nomadworkshop')!;
const gomoku = getProject('gomoku')!;
const stage = [outpost,dubforge,framework];
const stageCaptions = ['Outpost：一场炮台与敌群的波次防守。','DubForge：从逐句精修到多版本成片。','SSFramework：连接游戏、工具与生命周期。'];
const archive = ['aoe4-flow','eazybuildpipeline','learnopengl','intelligence-index-cost-linear','liss-web','utility-lab'].map(slug=>getProject(slug)!);
const first = archive[0];
const flow = [
 {name:'准备素材',caption:'导入视频，让输入和各制作阶段留在同一项目空间。'},
 {name:'逐句精修',caption:'对照画面，逐句调整双语字幕、时间与声源。'},
 {name:'多版成片',caption:'从同一个项目配置原声双语版、中文配音版等成片版本。'},
];
---
<Base title="Liss · 把想法做成作品">
 <div class="shell home-next">
  <section class="kinetic-hero" id="start" data-active="0" aria-labelledby="home-title">
   <div class="pointer-light" data-pointer-light aria-hidden="true"></div>
   <div class="hero-copy"><p class="hero-eyebrow">Liss · 独立开发与好奇心</p><h1 id="home-title" data-motion="hero"><span>把想法，</span><br/><span class="hero-accent">做成作品。</span></h1><p class="hero-introduction" data-motion="hero">我是 Liss，独立开发游戏、工具与交互实验。</p><div class="hero-actions" data-motion="hero"><a class="button" href="#selected" data-magnetic><span data-magnet-body>探索作品 <Icon size={19}/></span></a><a class="hero-library" href={sitePath('/projects/')}>浏览全部 {projects.length} 个工程</a></div></div>
   <div class="work-stage" data-work-stage data-active="0" data-ui>
    <div class="stage-objects" data-stage-objects>
     {stage.map((project,index)=><article class="stage-piece" data-stage-piece={index}><div class="stage-surface" data-stage-image><a href={sitePath(`/projects/${project.slug}/`)} aria-label={`查看 ${project.name}`} data-cursor="走进作品"><div class="screen-chrome" aria-hidden="true"><span></span><span></span><span></span><strong>{project.name}</strong></div><MediaImage image={project.cover} eager={index===0} sizes="(max-width: 760px) 90vw, 55vw"/><div class="screen-caption"><span>{project.category}</span><Icon size={15}/></div></a></div></article>)}
    </div>
    <div class="stage-bottom"><div class="stage-controls" role="group" aria-label="选择主画面中的工程">{stage.map((project,index)=><button type="button" data-stage-select={index} data-caption={stageCaptions[index]} data-href={sitePath(`/projects/${project.slug}/`)} aria-pressed={index===0}>{project.name}</button>)}</div><div class="stage-description"><p data-stage-caption aria-live="polite">{stageCaptions[0]}</p><a data-stage-link href={sitePath('/projects/outpost/')} aria-label="探索当前工程"><Icon size={22}/></a></div></div>
   </div>
   <a class="hero-scroll" href="#signal"><span>向下，碰一碰灵感</span><svg width="19" height="30" viewBox="0 0 19 30" aria-hidden="true"><path d="M9.5 1v26M2 19l7.5 8 7.5-8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></a>
  </section>

  <section class="signal-chapter" id="signal" aria-labelledby="signal-title">
   <div class="signal-field" data-signal-field>
    <div class="signal-copy"><span class="section-kicker">交互小实验 · SIGNAL FIELD</span><h2 id="signal-title">想法之间，<br/>有回响。</h2><p class="signal-instructions">移动鼠标，轻轻拨动连接。点一下空白，让信号找到通往作品的路。</p><p class="signal-fallback-copy">每次尝试，都连接着新的作品。也可以走进<a href={sitePath('/lab/')}>交互实验</a>，看看算法如何运转。</p><button class="signal-send" type="button" data-signal-send data-magnetic><span data-magnet-body>发送一束信号 <Icon size={19}/></span></button><p class="signal-status" data-signal-status role="status" aria-live="polite">当前目的地：Outpost</p></div>
    <div class="signal-canvas-wrap"><svg class="signal-fallback" viewBox="0 0 750 400" aria-hidden="true">{EDGES.map(([a,b])=><path d={`M${ANCHORS[a][0]*750} ${ANCHORS[a][1]*400}L${ANCHORS[b][0]*750} ${ANCHORS[b][1]*400}`}/>)}{ANCHORS.map(([x,y])=><circle cx={x*750} cy={y*400} r="2"/>)}{DESTINATIONS.map(target=><g style={`color:${target.color}`}><circle cx={ANCHORS[target.node][0]*750} cy={ANCHORS[target.node][1]*400} r="5"/><text x={ANCHORS[target.node][0]*750-14} y={ANCHORS[target.node][1]*400-12} text-anchor="end">{target.name}</text></g>)}</svg><canvas aria-hidden="true"></canvas><span class="signal-hint" aria-hidden="true">MOVE TO DISTURB · CLICK TO CONNECT</span></div>
   </div>
  </section>

  <div class="kinetic-strip" aria-hidden="true"><div data-kinetic-strip><span>PLAY</span><i>↗</i><span>BUILD</span><i>↗</i><span>EXPERIMENT</span><i>↗</i><span>REPEAT</span><i>↗</i></div></div>

  <section class="framework-chapter home-chapter" id="selected" aria-labelledby="framework-title">
   <header class="work-heading"><h2 id="framework-title" class="project-name" data-motion="reveal">SSFramework</h2><p data-motion="reveal">游戏背后，<br/>是不断生长的工具。</p></header>
   <div class="framework-composition"><div class="framework-notes"><p class="work-description">{framework.summary}</p><a class="text-link" href={sitePath('/projects/ssframework/')}>走进框架 <Icon size={18}/></a><figure class="binding-evidence" data-motion="shutter" data-motion-picture><MediaImage image={framework.gallery[3]} zoom group="home-framework" sizes="(max-width: 760px) 100vw, 38vw"/><figcaption>在 Hierarchy 中绑定节点，生成强类型代码。</figcaption></figure></div><div class="architecture-stage" data-architecture data-ui><FrameworkDiagram/><button class="architecture-replay" type="button" data-architecture-replay><Icon name="play" size={16}/> 重放交互流程</button></div></div>
  </section>

  <section class="workflow-chapter home-chapter" id="workflow" aria-labelledby="workflow-title" data-workflow data-ui>
   <header class="work-heading"><h2 id="workflow-title" data-motion="reveal">让好内容<br/>跨过语言。</h2><p data-motion="reveal">DubForge，<br/>一个可以反复精修的视频工作台。</p></header>
   <div class="workflow-composition"><div class="workflow-pictures"><div class="workflow-main" data-motion="reveal"><div data-scroll-layer><MediaImage image={dubforge.cover} zoom group="home-dubforge" sizes="(max-width: 760px) 100vw, 62vw"/></div></div><figure class="workflow-aside"><MediaImage image={dubforge.gallery[2]} zoom group="home-dubforge" sizes="(max-width: 760px) 60vw, 29vw"/><figcaption>同一项目，留下不同版本。</figcaption></figure></div><div class="workflow-story"><h3 class="project-name">DubForge</h3><p>{dubforge.summary}</p><div class="workflow-controls" role="group" aria-label="浏览 DubForge 制作流程">{flow.map((step,index)=><button type="button" data-flow-step={index} data-caption={step.caption} aria-pressed={index===0}>{step.name}</button>)}</div><svg class="workflow-diagram" viewBox="0 0 450 100" role="img" aria-label="视频素材经过逐句精修，生成多个成片版本"><path data-flow-path="0" d="M48 50H224"/><path data-flow-path="1" d="M224 50H402"/>{[48,224,402].map((x,index)=><g data-flow-node={index} data-active={index===0?'true':'false'} data-current={index===0?'true':'false'}><circle cx={x} cy="50" r="23"/><text x={x} y="56" text-anchor="middle">{['入','修','出'][index]}</text></g>)}</svg><p class="flow-caption" data-flow-caption role="status" aria-live="polite">{flow[0].caption}</p><a class="text-link" href={sitePath('/projects/dubforge/')}>探索完整工作流 <Icon size={18}/></a></div></div>
  </section>

  <section class="games-chapter home-chapter" id="games" aria-labelledby="games-title"><header class="work-heading"><h2 id="games-title" data-motion="reveal">规则有了形状，<br/>世界开始运转。</h2><p data-motion="reveal">从居民与资源，<br/>到敌群与炮火，再到落子间的搜索。</p></header><div class="games-landscape">
   <article class="game-scene game-scene--nomad" data-scroll-layer><a href={sitePath('/projects/nomadworkshop/')} class="game-scene__image" data-cursor="走进世界" data-motion="reveal"><MediaImage image={nomad.cover} sizes="(max-width: 760px) 100vw, 57vw"/></a><div><h3 class="project-name"><a href={sitePath('/projects/nomadworkshop/')}>NomadWorkshop</a></h3><p>{nomad.summary}</p></div></article>
   <article class="game-scene game-scene--outpost" data-scroll-layer><a href={sitePath('/projects/outpost/')} class="game-scene__image" data-cursor="走进世界" data-motion="reveal"><MediaImage image={outpost.cover} sizes="(max-width: 760px) 100vw, 46vw"/></a><div><h3 class="project-name"><a href={sitePath('/projects/outpost/')}>Outpost</a></h3><p>{outpost.summary}</p></div></article>
   <article class="game-scene game-scene--gomoku"><a href={sitePath('/projects/gomoku/')} class="game-scene__image" data-cursor="走进世界" data-motion="reveal"><MediaImage image={gomoku.cover} sizes="(max-width: 760px) 100vw, 40vw"/></a><div><h3 class="project-name"><a href={sitePath('/projects/gomoku/')}>Liss Gomoku</a></h3><p>{gomoku.summary}</p></div></article>
  </div></section>

  <section class="explore-chapter home-chapter" id="explore" aria-labelledby="explore-title" data-archive><header class="work-heading"><h2 id="explore-title" data-motion="reveal">好奇心，<br/>还有别的去处。</h2><p data-motion="reveal">工具、图形、算法，<br/>以及从实际需要出发的应用。</p></header><div class="explore-layout"><div class="explore-index">{archive.map((project,index)=><article data-archive-item data-selected={index===0?'true':'false'} data-preview-src={sitePath(project.cover.src)} data-preview-alt={project.cover.alt} data-preview-title={project.name} data-preview-summary={project.summary} data-preview-href={sitePath(`/projects/${project.slug}/`)}><a class="project-name" href={sitePath(`/projects/${project.slug}/`)}>{project.name.split(' · ')[0]}<Icon size={20}/></a><button type="button" data-archive-select aria-label={`预览 ${project.name}`}><Icon name="expand" size={17}/></button></article>)}<a href={sitePath('/projects/')} class="explore-all">全部 {projects.length} 个工程 <Icon size={18}/></a></div><aside class="explore-preview"><a data-archive-link href={sitePath(`/projects/${first.slug}/`)}><img data-archive-image src={sitePath(first.cover.src)} width={first.cover.width} height={first.cover.height} alt={first.cover.alt} loading="lazy" decoding="async"/></a><h3 class="project-name" data-archive-title>{first.name}</h3><p data-archive-summary>{first.summary}</p></aside></div></section>

  <section class="closing-chapter home-chapter" aria-labelledby="closing-title"><h2 id="closing-title">下一次尝试，<br/>从一个想法开始。</h2><div><p>我把游戏开发、工具制作和代码实验放在这里。它们记录了不同阶段的思考，也留下了继续改进的空间。</p><div class="closing-actions"><a class="button" href={sitePath('/lab/')} data-magnetic><span data-magnet-body>亲手试试 <Icon name="play" size={17}/></span></a><a class="text-link" href={communityUrl}>记录与交流 <Icon size={18}/></a><a class="text-link" href={sitePath('/about/')}>关于 Liss <Icon size={18}/></a></div></div></section>
 </div>
 <nav class="chapter-nav" data-chapter-nav aria-label="本页章节"><span class="chapter-progress" data-page-progress aria-hidden="true"></span><a href="#start" data-active="true" aria-current="location"><span>开场</span></a><a href="#signal"><span>连接</span></a><a href="#selected"><span>框架</span></a><a href="#workflow"><span>工具</span></a><a href="#games"><span>游戏</span></a><a href="#explore"><span>探索</span></a></nav>
</Base>
