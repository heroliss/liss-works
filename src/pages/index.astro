---
import { sitePath } from '../lib/site-path';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MediaImage from '../components/MediaImage.astro';
import LabWorkbench from '../components/LabWorkbench.astro';
import { projects, getProject } from '../data/projects';
import { getProjectSignature } from '../data/project-signatures';
import { prioritizeProjects } from '../data/project-priority';
import '../styles/home-projects.css';

const featured = prioritizeProjects(projects).filter(project => ['ssframework', 'dubforge'].includes(project.slug));
const games = ['nomadworkshop', 'outpost', 'gomoku'].map(slug => getProject(slug)!);
const applications = ['aoe4-flow', 'liss-web', 'intelligence-index-cost-linear'].map(slug => getProject(slug)!);
const eazy = getProject('eazybuildpipeline')!;
const experiments = ['learnopengl', 'sort-lab', 'route-lab'].map(slug => getProject(slug)!);
---
<Base>
 <div class="shell home-projects">
  <section aria-labelledby="home-title">
   <div class="hero-intro"><div><h1 class="display" id="home-title">Games, tools &amp; experiments.</h1><p>我是 Liss，独立开发游戏、工具与交互实验。</p></div><a href={sitePath('/projects/')} class="text-link">浏览全部 {projects.length} 个工程 <Icon size={18}/></a></div>
   <div class="home-featured">{featured.map((project, index) => <article class="home-feature" data-home-feature={project.slug}>
    <div class="home-feature__media"><MediaImage image={project.cover} eager={index === 0} zoom group="home-featured" sizes="(max-width: 760px) 100vw, 50vw"/></div>
    <div class="home-feature__body"><p class="home-direction">{getProjectSignature(project.slug).direction}</p><div class="home-feature__title"><h2 class="project-name"><a href={sitePath(`/projects/${project.slug}/`)}>{project.name}</a></h2><span>{project.status}</span></div><p class="home-summary">{project.summary}</p><ul class="home-highlights" aria-label={`${project.name} 亮点`}>{getProjectSignature(project.slug).highlights.map(highlight => <li>{highlight}</li>)}</ul><a class="text-link" href={sitePath(`/projects/${project.slug}/`)}>探索工程与实现 <Icon size={17}/></a></div>
   </article>)}</div>
  </section>

  <section class="section" aria-labelledby="games-title">
   <div class="section-heading"><div><h2 id="games-title">让规则长成游戏</h2><p>居民与资源的模拟、炮台与敌群的战斗，以及落子之间的搜索。</p></div><a class="text-link" href={sitePath('/projects/?group=games')}>游戏与 Unity 工具 <Icon size={17}/></a></div>
   <div class="home-project-row">{games.map(project => <article class="home-project" data-home-project={project.slug}>
    <a class="home-project__media" href={sitePath(`/projects/${project.slug}/`)} tabindex="-1" aria-hidden="true"><MediaImage image={project.cover} sizes="(max-width: 760px) 100vw, 33vw"/></a>
    <div class="home-project__body"><p class="home-direction">{getProjectSignature(project.slug).direction}</p><h3 class="project-name"><a href={sitePath(`/projects/${project.slug}/`)}>{project.name}</a></h3><p class="home-summary">{project.summary}</p><div class="home-project__footer"><span class="home-project__status">{project.status}</span><a class="text-link" href={sitePath(`/projects/${project.slug}/`)} aria-label={`查看 ${project.name}`}>查看工程 <Icon size={16}/></a></div></div>
   </article>)}</div>
   <a class="home-tool-bridge" href={sitePath(`/projects/${eazy.slug}/`)}><span class="home-tool-bridge__title"><Icon name="code" size={22}/><strong class="project-name">{eazy.name}</strong></span><span>第一份工作中的 Unity 资源与构建工具，把项目需求整理成可配置的流水线。</span><Icon size={20}/></a>
  </section>

  <section class="section" aria-labelledby="applications-title">
   <div class="section-heading"><div><h2 id="applications-title">从实际需要开始</h2><p>减少重复操作、留下想法，或看清 AI 的能力与费用。</p></div></div>
   <div class="home-project-row">{applications.map(project => <article class="home-project" data-home-project={project.slug}>
    <a class="home-project__media" href={sitePath(`/projects/${project.slug}/`)} tabindex="-1" aria-hidden="true"><MediaImage image={project.cover} sizes="(max-width: 760px) 100vw, 33vw"/></a>
    <div class="home-project__body"><p class="home-direction">{getProjectSignature(project.slug).direction}</p><h3 class="project-name"><a href={sitePath(`/projects/${project.slug}/`)}>{project.name}</a></h3><p class="home-summary">{project.summary}</p><div class="home-project__footer"><a class="text-link" href={sitePath(`/projects/${project.slug}/`)}>查看工程 <Icon size={16}/></a>{project.demo && <a class="text-link" href={project.demo} target="_blank" rel="noreferrer">在线体验 <Icon size={16}/></a>}</div></div>
   </article>)}</div>
  </section>

  <section class="section" aria-labelledby="lab-title">
   <div class="section-heading"><div><h2 id="lab-title">代码，也可以亲手试试</h2><p>点选起点与终点，看看最短路径如何穿过这张图。</p></div><a class="text-link" href={sitePath('/lab/')}>打开完整实验 <Icon size={17}/></a></div><LabWorkbench compact/>
   <div class="home-experiment-links">{experiments.map(project => <a href={sitePath(`/projects/${project.slug}/`)}><h3 class="project-name">{project.name}</h3><p>{getProjectSignature(project.slug).direction}</p><Icon size={18}/></a>)}</div>
  </section>

  <section class="section home-library" aria-labelledby="library-title"><div><h2 id="library-title">还有更多，留给你好奇。</h2><p>图形渲染、算法实验、桌面工具与早期作品。每个工程都保留它自己的来由和实现。</p></div><a class="button secondary" href={sitePath('/projects/')}>进入工程库 <Icon size={18}/></a></section>
 </div>
</Base>
