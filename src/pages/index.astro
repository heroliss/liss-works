---
import { sitePath } from '../lib/site-path';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MediaImage from '../components/MediaImage.astro';
import ProjectDownload from '../components/ProjectDownload.astro';
import LabWorkbench from '../components/LabWorkbench.astro';
import { projects, getProject } from '../data/projects';
import { getProjectSignature } from '../data/project-signatures';
const featured = ['nomadworkshop','outpost','dubforge'].map(slug => getProject(slug)!);
const tools = ['ssframework','eazybuildpipeline'].map(slug => getProject(slug)!);
const dataProjects = ['china-house-price-map','intelligence-index-cost-linear'].map(slug => getProject(slug)!);
---
<Base>
 <div class="shell"><section aria-labelledby="home-title">
 <div class="hero-intro"><div><h1 class="display" id="home-title">Games, tools &amp; experiments.</h1><p>独立开发的游戏、工具与交互实验。</p></div><a href={sitePath('/projects/')} class="text-link">浏览全部工程 <Icon size={18}/></a></div>
 <div class="showcase">{featured.map((project,index)=><article class="showcase-panel" id={`stage-${project.slug}`} role="tabpanel" aria-labelledby={`tab-${project.slug}`} hidden={index !== 0}>
 <div class="showcase__media"><MediaImage image={project.cover} eager={index === 0} zoom group="home-stage" sizes="(max-width: 760px) 100vw, 70vw"/><div class="showcase__caption"><span>{project.cover.kind} · {project.name}</span></div></div>
 <div class="showcase__info"><span>{getProjectSignature(project.slug).direction}</span><h2 class="project-name">{project.name}</h2><p>{project.summary}</p><ul>{getProjectSignature(project.slug).highlights.map(highlight=><li>{highlight}</li>)}</ul><div class="button-row"><a class="button" href={sitePath(`/projects/${project.slug}/`)}>探索工程 <Icon size={16}/></a>{project.download ? <ProjectDownload download={project.download} compact/> : <a class="button secondary" href={project.source} target="_blank" rel="noreferrer">源码 <Icon name="code" size={17}/></a>}</div></div>
 </article>)}</div>
 <div class="showcase-tabs" role="tablist" aria-label="切换精选工程">{featured.map((project,index)=><button id={`tab-${project.slug}`} type="button" role="tab" aria-selected={index===0} aria-controls={`stage-${project.slug}`} tabindex={index===0?0:-1} data-showcase-tab>{project.name}</button>)}<span>亲手探索，按你的节奏。</span></div>
 </section>
 <section class="section" aria-labelledby="tools-title"><div class="section-heading"><div><h2 id="tools-title">世界背后的工具</h2><p>从运行时的系统组织，到编辑器里的资源与构建流程。</p></div><a class="text-link" href={sitePath('/projects/?group=games')}>游戏与工具 <Icon size={17}/></a></div>
 <div class="tool-pair">{tools.map(project=><article class="tool-story"><a class="tool-story__image" href={sitePath(`/projects/${project.slug}/`)} aria-label={`查看 ${project.name}`}><MediaImage image={project.cover} sizes="(max-width: 760px) 100vw, 50vw"/></a><h3 class="project-name">{project.name}</h3><p>{project.summary}</p><div class="tag-list">{project.tags.slice(0,3).map(tag=><span>{tag}</span>)}</div><a class="text-link" href={sitePath(`/projects/${project.slug}/`)}>查看功能与用法 <Icon size={17}/></a></article>)}</div>
 </section>
 <section class="section" aria-labelledby="data-title"><div class="section-heading"><div><h2 id="data-title">把数据变得可探索</h2><p>在地图里移动，在坐标里比较。两项可以直接打开的在线工程。</p></div></div><div class="data-pair">{dataProjects.map(project=><article class="data-story"><a class="data-story__image" href={sitePath(`/projects/${project.slug}/`)} aria-label={`查看 ${project.name}`}><MediaImage image={project.cover} sizes="(max-width: 760px) 100vw, 50vw"/></a><h3 class="project-name">{project.name}</h3><p>{project.summary}</p><div class="button-row"><a class="text-link" href={sitePath(`/projects/${project.slug}/`)}>了解工程 <Icon size={16}/></a><a class="text-link" href={project.demo} target="_blank" rel="noreferrer">在线体验 <Icon size={16}/></a></div></article>)}</div></section>
 <section class="section" aria-labelledby="lab-title"><div class="section-heading"><div><h2 id="lab-title">代码，也可以亲手试试</h2><p>点选起点与终点，看看最短路径如何穿过这张图。</p></div><a class="text-link" href={sitePath('/lab/')}>打开完整实验 <Icon size={17}/></a></div><LabWorkbench compact/><div class="lab-bridge"><p>FloydShortestPath 的网页算法移植。完整实验里可以修改连接、查看距离矩阵，也可以观察遗传算法怎样排序。</p><a class="text-link" href={sitePath('/projects/floydshortestpath/')}>原 C# 工程 <Icon size={16}/></a></div></section>
 <section class="section" aria-labelledby="all-title"><div class="section-heading"><h2 id="all-title">工程与设计</h2><a class="text-link" href={sitePath('/projects/')}>进入工程库 <Icon size={17}/></a></div><div class="all-projects-mini">{projects.map(project=><a href={sitePath(`/projects/${project.slug}/`)} class="mini-project"><h3 class="project-name">{project.name}</h3><p>{getProjectSignature(project.slug).principle}</p><span>{getProjectSignature(project.slug).direction}</span></a>)}</div></section>
 <section class="section home-about"><p>我是 Liss，独立开发游戏、工具与各种交互实验。这里记录已经做出来的东西，也保留仍在生长的想法。</p><a href={sitePath('/about/')} class="text-link">关于这个展厅 <Icon size={17}/></a></section>
 </div>
</Base>

