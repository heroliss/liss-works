---
import { getProjectWorld } from '../data/project-worlds';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MediaImage from '../components/MediaImage.astro';
import FrameworkShowcase from '../components/FrameworkShowcase.astro';
import DubForgeWorkflow from '../components/DubForgeWorkflow.astro';
import HomeAtmosphere from '../components/HomeAtmosphere.astro';
import ExplorationInvitation from '../components/ExplorationInvitation.astro';
import { projects, getProject } from '../data/projects';
import { sitePath, communityUrl } from '../lib/site-path';
import '../styles/home-next.css';
import '../styles/expressive-home.css';
import '../styles/project-showcase.css';
import '../styles/interactive-showcase.css';
import '../styles/spatial-scenes.css';
import '../styles/atmosphere-polish.css';
import '../styles/background-depth.css';
import '../styles/spatial-materials.css';
const framework = getProject('ssframework')!;
const dubforge = getProject('dubforge')!;
const outpost = getProject('outpost')!;
const nomad = getProject('nomadworkshop')!;
const gomoku = getProject('gomoku')!;
const stage = [outpost,dubforge,framework,nomad,gomoku];
const stageCaptions = stage.map(project => project.summary);

---
<Base title="Liss · 把想法做成作品">
 <div class="shell home-next">
  <HomeAtmosphere/>
  <section class="kinetic-hero" id="start" data-active="0" data-ambient-region aria-labelledby="home-title">
   <HomeAtmosphere variant="hero"/>
   <div class="hero-light-clip" aria-hidden="true"><div class="pointer-light" data-pointer-light></div></div>
   <div class="hero-copy"><h1 id="home-title" data-motion="hero"><span>把想法，</span><br/><span class="hero-accent">做成作品。</span></h1><p class="hero-introduction" data-motion="hero">我是 Liss，独立开发游戏、工具与交互实验。</p><div class="hero-actions" data-motion="hero"><a class="hero-continue" href="#selected">继续向下探索 <Icon size={17}/></a><a class="hero-library" href={sitePath('/projects/')}>浏览全部 {projects.length} 个工程</a></div></div>
   <div class="work-stage" data-work-stage data-active="0" data-ui>
    <div class="stage-objects" data-stage-objects>
     {stage.map((project,index)=><article class="stage-piece" data-stage-piece={index} data-stage-offset={index} data-project={project.slug}><button type="button" class="stage-card" data-stage-card={index} data-href={sitePath(`/projects/${project.slug}/`)} aria-pressed={index===0} aria-controls="stage-overview" aria-label={index===0 ? `打开 ${project.name} 项目` : `将 ${project.name} 切到前景`} disabled><span class="stage-surface" data-stage-image><span class="screen-chrome" aria-hidden="true"><span></span><span></span><span></span><strong>{project.name.split(' · ')[0]}</strong></span><MediaImage image={project.cover} eager={index===0} sizes="(max-width: 760px) 90vw, 55vw"/><span class="screen-caption"><span>{project.category}</span></span></span></button></article>)}
    </div>
    <div class="stage-bottom"><div class="stage-controls" role="group" aria-label="选择主画面中的工程">{stage.map((project,index)=><button type="button" data-stage-select={index} data-name={project.name} data-tone={getProjectWorld(project.slug).accent} data-category={project.category} data-caption={stageCaptions[index]} data-href={sitePath(`/projects/${project.slug}/`)} aria-pressed={index===0}>{project.name}</button>)}</div><div class="stage-description" id="stage-overview"><p class="stage-category" data-stage-category>{stage[0].category}</p><h2 class="project-name" data-stage-name>{stage[0].name}</h2><p class="stage-summary" data-stage-caption aria-live="polite">{stageCaptions[0]}</p><a class="button stage-detail-link" data-stage-link data-project-enter href={sitePath('/projects/outpost/')}>查看项目 <Icon size={20}/></a></div><noscript><div class="stage-fallback-links">{stage.map(project=><a href={sitePath(`/projects/${project.slug}/`)}>{project.name} <Icon size={15}/></a>)}</div></noscript></div>
   </div>
   <a class="hero-scroll" href="#selected"><span>向下，看作品如何运转</span><svg width="19" height="30" viewBox="0 0 19 30" aria-hidden="true"><path d="M9.5 1v26M2 19l7.5 8 7.5-8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></a>
  </section>

  <section class="process-band" data-marquee aria-label="创作过程与动态控制">
   <div class="marquee-tilt" data-marquee-plane><div class="kinetic-strip" aria-hidden="true"><div data-kinetic-strip>{[0,1].map(()=><div class="marquee-group" data-marquee-group>{['PLAY','BUILD','EXPERIMENT','REPEAT'].map(word=><><span>{word}</span><i>↗</i></>)}</div>)}</div></div></div>
   <button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false" aria-label="暂停页面动态"><span class="motion-symbol-pause"><Icon name="pause" size={15}/></span><span class="motion-symbol-play"><Icon name="play" size={15}/></span><span data-motion-toggle-label>暂停动态</span></button>
  </section>

  <section class="framework-chapter home-chapter" id="selected" aria-labelledby="framework-title">
   <HomeAtmosphere variant="framework"/>
   <header class="work-heading"><h2 id="framework-title" class="project-name" data-motion="reveal">SSFramework</h2><p data-motion="reveal">游戏背后，<br/>是不断生长的工具。</p></header>
   <div class="framework-composition"><div class="framework-notes"><p class="work-description">{framework.summary}</p><p class="framework-core-note">从职责分层与数据流，看到运行现场，再进入日常工具。</p><a class="text-link" href={sitePath('/projects/ssframework/')}>走进框架 <Icon size={18}/></a></div><FrameworkShowcase/></div>
  </section>

  <DubForgeWorkflow/>

  <section class="games-chapter home-chapter" id="games" aria-labelledby="games-title"><HomeAtmosphere variant="games"/><header class="work-heading"><h2 id="games-title" data-motion="reveal">规则有了形状，<br/>世界开始运转。</h2><p data-motion="reveal">从居民与资源，<br/>到敌群与炮火，再到落子间的搜索。</p></header><div class="games-landscape">
   <article class="game-scene game-scene--nomad" data-scroll-layer><div class="game-art game-art--nomad" data-project-atmosphere="nomad" style={`--media-ratio:${nomad.cover.width} / ${nomad.cover.height}`}><a href={sitePath('/projects/nomadworkshop/')} class="game-scene__image" data-motion="reveal"><MediaImage image={nomad.cover} sizes="(max-width: 760px) 100vw, 57vw"/></a><canvas aria-hidden="true"></canvas></div><div class="game-scene__copy"><h3 class="project-name"><a href={sitePath('/projects/nomadworkshop/')}>NomadWorkshop</a></h3><p>{nomad.summary}</p></div></article>
   <article class="game-scene game-scene--outpost" data-scroll-layer><div class="game-art game-art--outpost" data-project-atmosphere="outpost" style={`--media-ratio:${outpost.cover.width} / ${outpost.cover.height}`}><a href={sitePath('/projects/outpost/')} class="game-scene__image" data-motion="reveal"><MediaImage image={outpost.cover} sizes="(max-width: 760px) 100vw, 46vw"/></a><canvas aria-hidden="true"></canvas></div><div class="game-scene__copy"><h3 class="project-name"><a href={sitePath('/projects/outpost/')}>Outpost</a></h3><p>{outpost.summary}</p></div></article>
   <article class="game-scene game-scene--gomoku"><div class="game-art game-art--gomoku" data-project-atmosphere="gomoku" style={`--media-ratio:${gomoku.cover.width} / ${gomoku.cover.height}`}><a href={sitePath('/projects/gomoku/')} class="game-scene__image" data-motion="reveal"><MediaImage image={gomoku.cover} sizes="(max-width: 760px) 100vw, 40vw"/></a><canvas aria-hidden="true"></canvas></div><div class="game-scene__copy"><h3 class="project-name"><a href={sitePath('/projects/gomoku/')}>Liss Gomoku</a></h3><p>{gomoku.summary}</p></div></article>
  </div></section>

  <ExplorationInvitation/>

  <section class="closing-chapter home-chapter" aria-labelledby="closing-title"><HomeAtmosphere variant="closing"/><h2 id="closing-title">下一次尝试，<br/>从一个想法开始。</h2><div><p>我把游戏开发、工具制作和代码实验放在这里。它们记录了不同阶段的思考，也留下了继续改进的空间。</p><div class="closing-actions"><a class="button" href={sitePath('/lab/')} data-magnetic><span data-magnet-body>亲手试试 <Icon name="play" size={17}/></span></a><a class="text-link" href={communityUrl}>记录与交流 <Icon size={18}/></a><a class="text-link" href={sitePath('/about/')}>关于 Liss <Icon size={18}/></a></div></div></section>
 </div>
 <nav class="chapter-nav" data-chapter-nav aria-label="本页章节"><span class="chapter-progress" data-page-progress aria-hidden="true"></span><a href="#start" data-active="true" aria-current="location"><span>开场</span></a><a href="#selected"><span>框架</span></a><a href="#workflow"><span>工具</span></a><a href="#games"><span>游戏</span></a><a href="#explore"><span>探索</span></a></nav>
</Base>
