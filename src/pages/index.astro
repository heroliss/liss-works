---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MediaImage from '../components/MediaImage.astro';
import { projects, getProject } from '../data/projects';
import { prioritizeProjects } from '../data/project-priority';
import { sitePath, communityUrl } from '../lib/site-path';
import '../styles/home-next.css';
const framework = getProject('ssframework')!;
const dubforge = getProject('dubforge')!;
const games = ['nomadworkshop','outpost','gomoku'].map(slug => getProject(slug)!);
const map = getProject('china-house-price-map')!;
const ordered = prioritizeProjects(projects);
const framePool = [
 ...[0,1,2,3,6,7].map(index => ({ project: framework, image: framework.gallery[index] })),
 ...dubforge.gallery.map(image => ({ project: dubforge, image })),
 ...['nomadworkshop','outpost'].flatMap(slug => { const project = getProject(slug)!; return project.gallery.slice(0,2).map(image => ({ project, image })); }),
 ...['gomoku','learnopengl','intelligence-index-cost-linear','china-house-price-map','liss-web'].map(slug => { const project = getProject(slug)!; return { project, image: project.cover }; }),
];
const opening = ['ssframework','dubforge','nomadworkshop','outpost','gomoku','learnopengl'].map(slug => framePool.find(frame => frame.project.slug === slug)!);
const frames = [...opening, ...framePool.filter(frame => !opening.includes(frame))];
const flow = [
 { name:'准备素材', caption:'导入视频，让输入和各制作阶段留在同一项目空间。' },
 { name:'逐句精修', caption:'对照画面，逐句调整双语字幕、时间与声源。' },
 { name:'多版成片', caption:'从同一个项目配置原声双语版、中文配音版等成片版本。' },
];
---
<Base title="Liss · 游戏、工具与交互实验">
 <div class="shell home-next">
  <section class="archive-hero" aria-labelledby="home-title" data-contact-sheet>
   <div class="contact-sheet" data-motion="sheet">
    <div class="contact-intro"><h1 id="home-title" data-motion="hero">Liss Works</h1><p data-motion="hero">我是 Liss，独立开发游戏、工具与交互实验。</p><a class="button" href={sitePath('/projects/')} data-motion="hero">浏览全部工程 <Icon size={18}/></a><p class="contact-note">从 Unity 架构到视频译制，<br/>从一个想法到可以使用的作品。</p></div>
    {frames.map(({project,image},index) => <a class="contact-frame" href={sitePath(`/projects/${project.slug}/`)} data-contact-item data-preview={`${project.name}：${image.kind}`} aria-label={`探索 ${project.name}：${image.kind}`}><MediaImage image={image} eager={index < 4} sizes="(max-width: 600px) 50vw, (max-width: 1000px) 25vw, 17vw"/><span>{project.name.split(' · ')[0]}</span></a>)}
   </div>
   <div class="sheet-caption"><p data-preview-label aria-live="polite">每一帧，都来自一个实际运行的工程。</p><a href="#selected" class="text-link">深入看看 <Icon name="chevron" size={17}/></a></div>
  </section>
  <section class="selected-work home-chapter" id="selected" aria-labelledby="selected-title">
   <div class="chapter-heading"><h2 id="selected-title" data-motion="reveal">持续生长的工程</h2><p data-motion="reveal">把实践中反复遇到的问题，整理成可以继续使用的工具。</p></div>
   <article class="framework-spread">
    <div class="spread-copy"><h3 class="project-name" data-motion="reveal"><a href={sitePath('/projects/ssframework/')}>SSFramework</a></h3><p data-motion="reveal">{framework.summary}</p><dl class="spread-facts"><div><dt>关注</dt><dd>业务分层与资源生命周期</dd></div><div><dt>实践</dt><dd>Unity 游戏与编辑器工具</dd></div></dl><a href={sitePath('/projects/ssframework/')} class="text-link">查看架构与实现 <Icon size={17}/></a></div>
    <div class="spread-picture" data-motion="shutter" data-motion-picture><MediaImage image={framework.gallery[0]} zoom group="home-framework" sizes="(max-width: 760px) 100vw, 65vw"/></div>
    <div class="spread-evidence"><figure data-motion="reveal"><MediaImage image={framework.gallery[3]} zoom group="home-framework" sizes="(max-width: 760px) 100vw, 35vw"/><figcaption>从 Hierarchy 中直接绑定节点</figcaption></figure><figure data-motion="reveal"><MediaImage image={framework.gallery[6]} zoom group="home-framework" sizes="(max-width: 760px) 100vw, 45vw"/><figcaption>生成可追踪的强类型代码</figcaption></figure></div>
   </article>
  </section>
  <section class="workflow-chapter home-chapter" aria-labelledby="workflow-title" data-workflow data-ui>
   <div class="chapter-heading"><h2 id="workflow-title" data-motion="reveal">让好内容跨过语言</h2><p data-motion="reveal">DubForge，把视频译制连成可精修、可复用的工作流。</p></div>
   <div class="workflow-layout"><div class="workflow-picture" data-motion="reveal"><MediaImage image={dubforge.cover} zoom group="home-dubforge" sizes="(max-width: 760px) 100vw, 65vw"/></div><div class="workflow-story"><h3 class="project-name" data-motion="reveal">DubForge</h3><p data-motion="reveal">{dubforge.summary}</p><div class="workflow-controls" role="group" aria-label="浏览 DubForge 制作流程">{flow.map((step,index) => <button type="button" data-flow-step={index} data-caption={step.caption} aria-pressed={index===0}>{step.name}</button>)}</div>
     <svg class="workflow-diagram" viewBox="0 0 450 100" role="img" aria-label="视频素材经过逐句精修，生成多个成片版本"><path data-flow-path="0" d="M48 50 H224"/><path data-flow-path="1" d="M224 50 H402"/>{[48,224,402].map((x,index) => <g data-flow-node={index} data-active={index===0?'true':'false'} data-current={index===0?'true':'false'}><circle cx={x} cy="50" r="23"/><text x={x} y="56" text-anchor="middle">{['入','修','出'][index]}</text></g>)}</svg>
     <p class="flow-caption" data-flow-caption role="status" aria-live="polite">{flow[0].caption}</p><a class="text-link" href={sitePath('/projects/dubforge/')}>探索完整工作流 <Icon size={17}/></a></div></div>
  </section>
  <section class="game-chapter home-chapter" aria-labelledby="games-title">
   <div class="chapter-heading"><h2 id="games-title" data-motion="reveal">让规则长成游戏</h2><p data-motion="reveal">居民与资源的模拟、炮台与敌群的战斗，以及落子之间的搜索。</p></div>
   <div class="game-composition">{games.map((project,index) => <article class:list={['game-piece',{'game-piece--wide':index===0}]}><a href={sitePath(`/projects/${project.slug}/`)} class="game-image" data-motion="reveal"><MediaImage image={project.cover} sizes={index===0?'(max-width: 760px) 100vw, 60vw':'(max-width: 760px) 100vw, 40vw'}/></a><div class="game-caption"><h3 class="project-name"><a href={sitePath(`/projects/${project.slug}/`)}>{project.name.split(' · ')[0]}</a></h3><p>{project.summary}</p></div>{index===0 && <div class="game-followups">{project.gallery.slice(1,3).map(image => <a href={sitePath(`/projects/${project.slug}/`)} data-motion="reveal"><MediaImage image={image} sizes="(max-width: 760px) 50vw, 30vw"/></a>)}</div>}</article>)}</div>
  </section>
  <section class="index-chapter home-chapter" aria-labelledby="index-title">
   <div class="chapter-heading"><h2 id="index-title" data-motion="reveal">工程档案</h2><p data-motion="reveal">{projects.length} 个工程，各有来由。选一个名字，看看它如何运转。</p></div>
   <div class="spine-index">{ordered.map(project => <a class="project-spine" href={sitePath(`/projects/${project.slug}/`)} data-motion="reveal"><span class="project-name">{project.name.split(' · ')[0]}</span><small>{project.category.split(' / ')[0]}</small></a>)}</div>
   <div class="index-close"><p>图形、算法、桌面程序，和为实际需要而做的应用。</p><a class="button secondary" href={sitePath('/projects/')}>查找工程 <Icon name="search" size={18}/></a></div>
  </section>
  <section class="map-chapter home-chapter" aria-labelledby="map-title">
   <div class="map-copy"><h2 id="map-title" data-motion="reveal">数据，也有画面</h2><p data-motion="reveal">全国房价图，把城市、区县与价格放回地图里。</p><a class="text-link" href={sitePath('/projects/china-house-price-map/')}>查看地图工程 <Icon size={17}/></a><a class="text-link" href={sitePath('/lab/')}>亲手试试算法实验 <Icon size={17}/></a></div>
   <figure class="map-picture" data-motion="reveal">{map.video ? <video controls playsinline preload="none" poster={sitePath(map.video.poster)} aria-label="全国房价图交互演示"><source src={sitePath(map.video.src)} type="video/mp4"/>浏览器无法播放视频，请<a href={sitePath(map.video.src)}>下载演示片段</a>。</video> : <MediaImage image={map.cover}/>}<figcaption>浏览城市、定位区域，观察数据与地图的联系。</figcaption></figure>
  </section>
  <section class="home-about home-chapter" aria-labelledby="about-title"><h2 id="about-title" data-motion="reveal">关于这些作品</h2><div><p data-motion="reveal">我把游戏开发、工具制作和代码实验放在这里。它们记录了不同阶段的思考，也留下了继续改进的空间。</p><div class="about-actions"><a class="text-link" href={sitePath('/about/')}>关于 Liss <Icon size={17}/></a><a class="text-link" href={communityUrl}>记录与交流 <Icon size={17}/></a></div></div></section>
 </div>
</Base>
