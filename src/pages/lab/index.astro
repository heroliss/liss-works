---
import Base from '../../layouts/Base.astro';
import LabWorkbench from '../../components/LabWorkbench.astro';
import Icon from '../../components/Icon.astro';
import { sitePath } from '../../lib/site-path';
import { webProjects } from '../../data/web-projects';
---
<Base title="交互实验" active="lab" description="亲手探索算法、结构映射与本地实用工具，修改输入，观察不同结果。"><div class="shell lab-page interactive-page"><div class="page-intro lab-intro"><h1 class="display">交互实验</h1><p data-motion="reveal">让输入改变结果，让代码变得直观。算法和小工具，都可以直接打开试试。</p></div><div class="lab-instrument" data-ui="true"><LabWorkbench/></div><section class="section" aria-labelledby="web-tools-title"><div class="section-heading"><h2 id="web-tools-title" data-motion="reveal">浏览器里的小工具</h2><p>打开即用，数据在本机处理。</p></div><div class="web-tool-grid">{webProjects.map(project => <a class="web-tool" href={sitePath(project.demo!)} data-motion="reveal"><div><h3>{project.name.split(' · ')[0]}</h3><p class="web-tool-kind">{project.category}</p><p>{project.summary}</p></div><Icon name="arrow" size={22}/></a>)}</div></section></div></Base>

