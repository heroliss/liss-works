---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ArchiveTile from '../../components/ArchiveTile.astro';
import { projects, groups } from '../../data/projects';
import { prioritizeProjects } from '../../data/project-priority';
import { getProjectSignature } from '../../data/project-signatures';
import { getProjectWorld } from '../../data/project-worlds';
import { sitePath } from '../../lib/site-path';
import '../../styles/archive-atlas.css';
import '../../styles/background-depth.css';
import '../../styles/spatial-materials.css';
const orderedProjects = prioritizeProjects(projects);
const initial = orderedProjects[0];
const signature = getProjectSignature(initial.slug);
const tags = ['Unity','C#','C++','AI','Python','Web','Qt','.NET','OpenGL','算法'];
---
<Base title="全部工程" active="projects" description={`浏览 Liss 的${projects.length}个独立开发工程：游戏与Unity工具、AI与数据应用、图形与算法实验。`}>
 <div class="shell archive-page archive-atlas" data-project-atlas style={`--atlas-tone:${getProjectWorld(initial.slug).accent}`}>
  <div class="atlas-aura" aria-hidden="true"></div>
  <div class="atlas-edge-veil" aria-hidden="true"><div class="atlas-field-scroll"><div class="atlas-field" data-atlas-field><svg viewBox="0 0 1800 1000" fill="none" preserveAspectRatio="xMidYMid meet"><defs><linearGradient id="atlas-light" x1="320" y1="850" x2="1450" y2="140" gradientUnits="userSpaceOnUse"><stop stop-color="currentColor" stop-opacity="0"/><stop offset=".4" stop-color="currentColor" stop-opacity=".18"/><stop offset="1" stop-color="currentColor" stop-opacity=".02"/></linearGradient></defs><path d="M-280 820C120 450 392 1100 1010 604S1570 84 2050 260M-260 850C140 480 412 1130 1030 634S1590 114 2070 290" stroke="url(#atlas-light)"/><path d="M690 210 1274 120 1550 500 964 604Z" fill="url(#atlas-light)"/><path d="M692 210V232L964 626 1550 523V500L964 604Z" fill="currentColor" opacity=".025"/><path d="M1050 180C1430 3 1700 315 1500 613S1550 1050 1990 910" stroke="currentColor" stroke-opacity=".08" stroke-width="24"/></svg></div></div></div>
  <header class="atlas-intro"><div><p class="atlas-total">{projects.length} 个工程 · 按兴趣探索</p><h1>工程库<span aria-hidden="true">↗</span></h1></div><p>游戏、工具、图形和算法。<br/>完整的作品与正在生长的原型，都在这里。</p><button class="atlas-motion-toggle" type="button" data-atlas-motion-toggle aria-pressed="false" aria-label="暂停页面动态"><Icon name="pause" size={15}/><span data-atlas-motion-label>暂停动态</span></button></header>
  <div class="filters atlas-filters" data-filters data-ui="true"><div class="filters-top"><label class="search-box"><span>查找工程</span><Icon name="search" size={19}/><input type="search" id="project-search" placeholder="搜索名称、用途或技术" autocomplete="off"/></label><p class="results-count" aria-live="polite" data-result-count>共 {projects.length} 个工程</p></div><div class="filter-buttons" role="group" aria-label="工程分类"><button type="button" data-group-filter="all" aria-pressed="true">全部工程</button>{groups.map(group=><button type="button" data-group-filter={group.id} aria-pressed="false">{group.label}</button>)}</div><div class="filter-bottom"><label>技术标签<select id="tag-filter"><option value="">全部技术</option>{tags.map(tag=><option value={tag}>{tag}</option>)}</select></label><button class="reset-filter" type="button" data-reset-filters>重置筛选</button></div></div>
  <section class="atlas-stage" data-atlas-stage aria-label="当前工程预览">
   <div class="atlas-display-copy"><p class="atlas-category" data-atlas-category>{initial.category}</p><h2 class="project-name" data-atlas-title>{initial.name.split(' · ')[0]}</h2><p class="atlas-summary" data-atlas-summary>{initial.summary}</p><dl class="atlas-facts"><div><dt>设计主张</dt><dd data-atlas-principle>{signature.principle}</dd></div><div><dt>技术方向</dt><dd data-atlas-direction>{signature.direction}</dd></div></dl><a class="atlas-enter" data-atlas-link href={sitePath(`/projects/${initial.slug}/`)} data-project-enter>走进工程 <Icon size={21}/></a></div>
   <div class="atlas-stage-art"><div class="atlas-stage-camera"><div class="atlas-float" data-atlas-float><div class="atlas-preview-plane" data-atlas-preview-tilt style={`--atlas-ratio:${initial.cover.width/initial.cover.height}`}><div class="atlas-preview-content" data-atlas-preview-content><span class="atlas-preview-depth" aria-hidden="true"></span><a class="atlas-preview-link" data-atlas-link href={sitePath(`/projects/${initial.slug}/`)} aria-label={`打开 ${initial.name} 项目`}><img data-atlas-image src={sitePath(initial.cover.src)} width={initial.cover.width} height={initial.cover.height} alt={initial.cover.alt} decoding="async" fetchpriority="high"/></a><span class="atlas-preview-edge" aria-hidden="true"></span></div></div></div></div><div class="atlas-stage-footer"><button type="button" data-atlas-previous aria-label="预览上一个工程"><Icon name="back" size={21}/></button><p data-atlas-position>1 / {projects.length}</p><button type="button" data-atlas-next aria-label="预览下一个工程"><Icon name="chevron" size={21}/></button><a href="#atlas-gallery">浏览图版 <Icon name="chevron" size={16}/></a></div></div>
   <p class="sr-only" data-atlas-status role="status" aria-live="polite">当前预览 {initial.name}</p>
  </section>
  <div class="empty-state atlas-empty" data-empty hidden><h2>没有匹配的工程</h2><p>试试其他名称或技术，也可以清除筛选查看全部。</p><button class="button secondary" type="button" data-reset-filters>清除筛选</button></div>
  <div class="atlas-gallery" id="atlas-gallery">{groups.map(group=><section class="atlas-shelf" data-atlas-group={group.id} aria-labelledby={`atlas-group-${group.id}`}><header class="atlas-shelf-heading"><div><h2 id={`atlas-group-${group.id}`}>{group.label}</h2><p>{group.description}</p></div><span data-atlas-group-count>{orderedProjects.filter(project=>project.group===group.id).length} 个工程</span></header><div class="atlas-wall">{orderedProjects.filter(project=>project.group===group.id).map((project,index)=><ArchiveTile project={project} index={index}/>)}</div></section>)}</div>
 </div><script>import '../../scripts/project-filter';</script>
</Base>

