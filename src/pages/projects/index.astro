---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ArchiveTile from '../../components/ArchiveTile.astro';
import WorksTable from '../../components/WorksTable.astro';
import { projects, groups } from '../../data/projects';
import { prioritizeProjects } from '../../data/project-priority';
import { getProjectWorld } from '../../data/project-worlds';
import '../../styles/archive-atlas.css';
import '../../styles/background-depth.css';
import '../../styles/spatial-materials.css';
const orderedProjects = prioritizeProjects(projects);
const tags = ['Unity','C#','C++','AI','Python','Web','WebGL 2','Three.js','Qt','.NET','OpenGL','算法'];
---
<Base title="全部工程" active="projects" description={`浏览 Liss 的${projects.length}个独立开发工程：游戏与Unity工具、AI与数据应用、图形与算法实验。`}>
 <div class="shell archive-page archive-atlas" data-project-atlas style="--atlas-tone:#9cdef1">
  <div class="atlas-aura" aria-hidden="true"></div>
  <div class="atlas-edge-veil" aria-hidden="true"><div class="atlas-field-scroll"><div class="atlas-field" data-atlas-field><svg viewBox="0 0 1800 1000" fill="none" preserveAspectRatio="xMidYMid meet"><defs><linearGradient id="atlas-light" x1="100" y1="850" x2="1230" y2="140" gradientUnits="userSpaceOnUse"><stop stop-color="currentColor" stop-opacity="0"/><stop offset=".4" stop-color="currentColor" stop-opacity=".18"/><stop offset="1" stop-color="currentColor" stop-opacity=".02"/></linearGradient></defs><path d="M-280 820C120 450 392 1100 1010 604S1570 84 2050 260M-260 850C140 480 412 1130 1030 634S1590 114 2070 290" stroke="url(#atlas-light)"/><path d="M470 210 1054 120 1330 500 744 604Z" fill="url(#atlas-light)"/><path d="M472 210V232L744 626 1330 523V500L744 604Z" fill="currentColor" opacity=".025"/><path d="M1050 180C1430 3 1700 315 1500 613S1550 1050 1990 910" stroke="currentColor" stroke-opacity=".08" stroke-width="24"/></svg></div></div></div>
  <WorksTable/>
  <div class="filters atlas-filters" id="atlas-filters" data-filters data-ui="true"><div class="filters-top"><label class="search-box"><span>查找工程</span><Icon name="search" size={19}/><input type="search" id="project-search" placeholder="搜索名称、用途或技术" autocomplete="off"/></label><p class="results-count" aria-live="polite" data-result-count>共 {projects.length} 个工程</p></div><div class="filter-buttons" role="group" aria-label="工程分类"><button type="button" data-group-filter="all" aria-pressed="true" style="--tone:#eef2ec">全部工程</button>{groups.map(group=><button type="button" data-group-filter={group.id} aria-pressed="false" style={`--tone:${group.tone}`}>{group.label}</button>)}</div><div class="filter-bottom"><label>技术标签<select id="tag-filter"><option value="">全部技术</option>{tags.map(tag=><option value={tag}>{tag}</option>)}</select></label><button class="atlas-random" type="button" data-atlas-random><Icon name="play" size={15}/>随机看看</button><button class="reset-filter" type="button" data-reset-filters>重置筛选</button></div></div>
  <div class="empty-state atlas-empty" data-empty hidden><h2>没有匹配的工程</h2><p>试试其他名称或技术，也可以清除筛选查看全部。</p><button class="button secondary" type="button" data-reset-filters>清除筛选</button></div>
  <div class="atlas-gallery" id="atlas-gallery">{groups.map(group=><section class="atlas-shelf" data-atlas-group={group.id} aria-labelledby={`atlas-group-${group.id}`} style={`--group-tone:${group.tone}`}><header class="atlas-shelf-heading"><div><h2 id={`atlas-group-${group.id}`}>{group.label}</h2><p>{group.description}</p><span class="atlas-shelf-dots" aria-hidden="true">{orderedProjects.filter(project=>project.group===group.id).map(project=><i style={`--dot:${getProjectWorld(project.slug).accent}`}></i>)}</span></div><span data-atlas-group-count>{orderedProjects.filter(project=>project.group===group.id).length} 个工程</span></header><div class="atlas-wall">{orderedProjects.filter(project=>project.group===group.id).map((project,index)=><ArchiveTile project={project} index={index}/>)}</div></section>)}</div>
 </div><script>import '../../scripts/project-filter';</script>
</Base>

