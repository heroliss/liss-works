---
import { communityUrl } from '../../lib/site-path';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CreatorRoom from '../../components/CreatorRoom.astro';
import '../../styles/about-creator.css';
---
<Base title="关于" active="about" description="我是 Liss，独立开发游戏、Unity 工具、AI 应用与交互实验。把想法做成可以一试的东西，也欢迎来聊聊。">
 <div class="about-creator" data-about-creator>
  <header class="creator-about__opening">
   <h1 id="about-title" aria-label="我是 Liss"><span>我是</span> <strong>Liss</strong></h1>
   <div class="creator-about__intro">
    <p class="creator-about__lead">我喜欢把想法做成<span>可以运行</span>、<span>可以操作</span>、<span>可以看见</span>的东西。</p>
   </div>
  </header>

  <div class="creator-about__scene"><CreatorRoom/></div>

  <section class="creator-about__afterword" aria-labelledby="creator-afterword-title">
   <h2 id="creator-afterword-title">从想法，<br/>到可以一试。</h2>
   <div class="creator-about__practice">
    <p class="creator-about__scope">独立开发游戏、Unity 工具、AI 应用与交互实验。</p>
    <p>有些来自工作和日常需求，有些出于好奇；先做一个可以试的版本，再慢慢打磨。</p>
    <p>一个问题、一点使用心得，或一个还没成形的想法，都可以成为下一段对话。</p>
    <div class="creator-about__contact">
     <a class="creator-about__talk" href={communityUrl}><Icon name="chat" size={20}/>来聊聊 <Icon size={20}/></a>
     <div class="creator-about__destinations">
      <p>Liss Community · 想法、问题与分享</p>
      <a class="creator-about__github" href="https://github.com/heroliss" target="_blank" rel="noreferrer" aria-label="在 GitHub 找到 Liss（新窗口）"><Icon name="github" size={18}/>在 GitHub 找到我 <Icon size={16}/></a>
     </div>
    </div>
   </div>
  </section>
 </div>
</Base>
