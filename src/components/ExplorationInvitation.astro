---
import { getProject, projects } from '../data/projects';
import { getProjectWorld } from '../data/project-worlds';
import { sitePath } from '../lib/site-path';
import MediaImage from './MediaImage.astro';
import Icon from './Icon.astro';
import '../styles/exploration-invitation.css';

const light = getProject('learnopengl')!;
const intelligence = getProject('intelligence-index-cost-linear')!;
const nomad = getProject('nomadworkshop')!;
const resident = nomad.gallery.find(image => image.src.includes('05-resident-and-world-1080'));
if (!resident) throw new Error('Exploration invitation needs the genuine Nomad resident-state capture');
const questions = [
  { question: '一张平面贴图，怎么看起来有凹凸？', lens: '图形', route: 'OpenGL', path: '图形与算法实验 / OpenGL', action: '看图形类工程',
    detail: '同一只木箱，换上法线和高度贴图后，表面就有了深浅。',
    work: 'LearnOpenGL', image: light.cover, tone: getProjectWorld(light.slug).accent,
    href: '/projects/?group=graphics&tag=OpenGL' },
  { question: '模型越聪明，就一定越贵吗？', lens: 'AI 与数据', route: '交互图表', path: 'AI 与数据 / AI', action: '看 AI 与数据类工程',
    detail: '把公开模型的能力分数和使用成本画在同一张图上，一眼看出性价比。',
    work: 'Intelligence × Cost', image: intelligence.cover, tone: getProjectWorld(intelligence.slug).accent,
    href: '/projects/?group=ai-data&tag=AI' },
  { question: '游戏里的居民，怎么决定下一步做什么？', lens: '游戏', route: 'Unity', path: '游戏与实时场景 / Unity', action: '看游戏类工程',
    detail: '居民自己的需求、工作的价值和走过去的距离，一起决定它接下来去哪。',
    work: 'NomadWorkshop', image: resident, tone: getProjectWorld(nomad.slug).accent,
    href: '/projects/?group=games&tag=Unity' },
];
---
<section class="exploration-invitation home-chapter" id="explore" aria-labelledby="explore-title"
  data-exploration-invitation data-invite-active="0" style={`--invite-tone:${questions[0].tone};--invite-ambience:${questions[0].tone}`}>
  <div class="invitation-darkroom" aria-hidden="true"><div class="invitation-light" data-invite-light></div></div>
  <header class="invitation-heading">
    <h2 id="explore-title">还有 {projects.length - 5} 个工程，<br/>换个问题接着逛。</h2>
    <div class="invitation-opening">
      <p>从一个具体的问题出发，也许更容易找到感兴趣的那一个。<br/>全部工程都按方向整理在工程库里。</p>
      <a href={sitePath('/projects/')} class="invitation-complete-link">打开工程库<Icon size={27}/></a>
    </div>
  </header>
  <div class="invitation-composition">
    <div class="invitation-camera" data-invite-camera>
      <div class="invitation-motion" data-invite-plane>
        <div class="invitation-fold">
          <nav class="invitation-topics" aria-label="三个问题，三类工程">
            <p class="invitation-cuts-note">选一个问题，看看对应的工程。</p>
            <div class="invitation-cuts">
              {questions.map((question, index) => <a class={`invitation-question invitation-question--${index}`}
                data-invite-cue={index} data-active={index === 0 ? 'true' : undefined}
                href={sitePath(question.href)} aria-label={`${question.lens}，${question.question}，${question.action}`}
                style={`--question-tone:${question.tone}`}>
                <span class="invitation-topic-name">{question.lens}<small>{question.route}</small></span>
                <span class="invitation-question__text">{question.question}</span>
                <span class="invitation-question__route">{question.action}<span aria-hidden="true">↗</span></span>
                <span class="invitation-contact" aria-hidden="true"></span>
              </a>)}
            </div>
          </nav>
          <div class="invitation-pictures">
            {questions.map((question, index) => <figure class="invitation-picture" data-invite-picture={index}
              data-invite-tone={question.tone} hidden={index !== 0} inert={index !== 0}>
              <figcaption class="invitation-current-question">
                <p class="invitation-topic-path">{question.path}</p>
                <h3>{question.question}</h3>
              </figcaption>
              <div class="invitation-viewfinder">
                <span class="invitation-sheet invitation-sheet--far" aria-hidden="true"></span>
                <span class="invitation-sheet invitation-sheet--near" aria-hidden="true"></span>
                <span class="invitation-sheet invitation-sheet--return" aria-hidden="true"></span>
                <a class="invitation-picture-link" href={sitePath(question.href)} aria-label={question.action}>
                  <MediaImage image={question.image} sizes="(max-width: 760px) calc(100vw - 64px), 82vw"/>
                  <span class="invitation-photo-edge" aria-hidden="true"></span>
                </a>
              </div>
              <div class="invitation-evidence">
                <div><span class="invitation-work">{question.work}</span><p>{question.detail}</p></div>
                <a class="invitation-current-entry" href={sitePath(question.href)}>{question.action}<Icon size={24}/></a>
              </div>
            </figure>)}
          </div>
        </div>
      </div>
    </div>
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-invite-status></p>
</section>
