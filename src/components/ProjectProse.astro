---
interface Props {
  text: string;
  as?: 'p' | 'span';
  tone?: 'body' | 'lead' | 'principle';
  class?: string;
  reveal?: boolean;
}
const { text, as: Tag = 'p', tone = 'body', class: className, reveal = false } = Astro.props;

// Reading hierarchy belongs to authored blocks, not a keyword dictionary.
// Keep a sentence intact, including repeated terms and partial word matches.
---
<Tag class:list={['project-prose', `project-prose--${tone}`, className]} data-detail-reveal={reveal ? '' : undefined}>{text}</Tag>
