---
import type { ProjectSignature } from '../data/project-signatures';
import ProjectProse from './ProjectProse.astro';
interface Props { signature: ProjectSignature }
const { signature } = Astro.props;
---
<dl class="project-signature project-signature--editorial" aria-label="工程亮点">
  <div class="signature-entry signature-entry--direction" data-detail-reveal><dt>技术方向</dt><dd class="signature-direction">{signature.direction}</dd></div>
  <div class="signature-entry signature-entry--principle" data-detail-reveal><dt>设计主张</dt><dd class="signature-principle"><ProjectProse text={signature.principle} as="span" tone="principle"/></dd></div>
  <div class="signature-entry signature-entry--highlights" data-detail-reveal><dt>关键能力</dt><dd><ul class="signature-highlights">{signature.highlights.map(highlight => <li>{highlight}</li>)}</ul></dd></div>
</dl>
