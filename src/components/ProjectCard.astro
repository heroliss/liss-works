---
import { sitePath } from '../lib/site-path';
import type { Project } from '../data/types';
import MediaImage from './MediaImage.astro';
import Icon from './Icon.astro';
import { getProjectSignature } from '../data/project-signatures';
interface Props { project: Project; class?: string; variant?: 'card' | 'archive'; selected?: boolean; }
const { project, class: className = '', variant = 'card', selected = false } = Astro.props;
const signature = getProjectSignature(project.slug);
const displayName = project.name.split(' · ')[0];
const filterTags = new Set(project.tags);
if (project.tags.some(tag => tag.toLowerCase().includes('unity'))) filterTags.add('Unity');
if (project.tags.some(tag => tag.toLowerCase().includes('opengl'))) filterTags.add('OpenGL');
if (project.tags.some(tag => /ai|llm|nlp|word2vec/i.test(tag)) || project.slug === 'intelligence-index-cost-linear') filterTags.add('AI');
if (project.tags.some(tag => /javascript|typescript|vue|flask|litegraph/i.test(tag))) filterTags.add('Web');
if (project.tags.some(tag => tag.includes('算法'))) filterTags.add('算法');
if (project.tags.some(tag => /^qt(?:\s|\d|$)/i.test(tag))) filterTags.add('Qt');
if (project.tags.some(tag => tag.startsWith('.NET'))) filterTags.add('.NET');
---
<article class:list={['project-card', { 'project-card--archive': variant === 'archive' }, className]} data-project-card data-archive-item={variant === 'archive' ? true : undefined} data-active={variant === 'archive' && selected ? 'true' : undefined} data-preview-src={variant === 'archive' ? sitePath(project.cover.src) : undefined} data-preview-alt={variant === 'archive' ? project.cover.alt : undefined} data-preview-title={variant === 'archive' ? displayName : undefined} data-preview-summary={variant === 'archive' ? project.summary : undefined} data-preview-href={variant === 'archive' ? sitePath(`/projects/${project.slug}/`) : undefined} data-group={project.group} data-tags={Array.from(filterTags).join('|')} data-search={`${project.name} ${project.repo} ${project.summary} ${project.category} ${project.tags.join(' ')} ${signature.direction} ${signature.principle} ${signature.highlights.join(' ')}`}>
 {variant !== 'archive' && <div class="project-card__visual"><a class="project-card__image" href={sitePath(`/projects/${project.slug}/`)} tabindex="-1" aria-hidden="true"><MediaImage image={project.cover} sizes="(max-width: 700px) 100vw, 44vw" /></a></div>}
 <div class="project-card__body">
 <h2><a href={sitePath(`/projects/${project.slug}/`)} aria-label={project.name}>{displayName}<Icon size={20}/></a></h2>
 {displayName !== project.name && <p class="project-card__full-name">{project.name}</p>}
 {variant !== 'archive' && <><p>{project.summary}</p><p class="card-design">{signature.principle}</p></>}<div class="project-card__meta"><span>{project.category}</span><span>{project.status}</span></div>{variant === 'archive' ? <button class="archive-select" type="button" data-archive-select aria-pressed={selected} aria-label={`预览 ${displayName}`}>预览 <Icon name="expand" size={14}/></button> : <div class="tag-list">{project.tags.slice(0,3).map(tag=><span>{tag}</span>)}</div>}</div>
</article>

