---
import { dubforgeWorkflow } from '../data/dubforge-workflow';
import { sitePath } from '../lib/site-path';
import MediaImage from './MediaImage.astro';
import Icon from './Icon.astro';
import '../styles/dubforge-workflow.css';
interface Props { id?: string; detail?: boolean }
const { id = 'workflow', detail = false } = Astro.props;
const rollers = [74, 226, 378, 530, 682, 834];
---
<section class:list={['dub-reel', {'home-chapter': !detail, 'dub-reel--detail': detail}]} id={id} data-dub-reel aria-labelledby={`${id}-title`}>
 <header class="dub-reel-heading">
  <div><h2 id={`${id}-title`} class="project-name" data-motion="reveal">DubForge</h2><p class="dub-reel-title">一条视频的制作现场。</p></div>
  <div class="dub-reel-introduction"><p>素材变成文字，文字找到声音。九个真实工作区，让同一条视频留下不同的成片版本。</p>{!detail && <a class="text-link" href={sitePath('/projects/dubforge/')}>走进制作工作台 <Icon size={18}/></a>}</div>
 </header>
 <div class="dub-factory" id={`${id}-machine`}>
  <div class="dub-scene-world" data-scene-world>
  <svg class="dub-factory-geometry" viewBox="0 0 1320 820" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
   <path class="factory-back-wall" d="M74 40H1197L1292 134V626H74Z"/>
   <path class="factory-wall-seam" d="M74 142H1292M1077 40V626M1166 40V626M1219 80V626"/>
   <path class="factory-overhead" d="M-100 112H886L994 52H1440V88H1004L896 148H-100Z"/>
   <g class="factory-far-rail" data-factory-track="far">
    <path d="M-150 190H820L928 126H1460M-150 205H828L936 142H1460"/>
    {Array.from({length: 19}, (_, index) => <path d={`M${index * 68 - 110} 177V218`}/>)}
   </g>
   <path class="factory-screen-mount" d="M22 18H926L958 52V612H22Z"/>
   <path class="factory-screen-mount-edge" d="M22 18V612H958M926 18L958 52"/>
   <path class="factory-support" d="M201 570H237V710H201ZM822 570H858V710H822Z"/>
   <path class="factory-console-pedestal" d="M1053 497H1101V668H1053ZM995 668H1159V688H995Z"/>
   <path class="factory-floor" d="M-150 812H1460M972 790L1200 820M815 790L878 820M402 790L302 820"/>
   <path class="factory-light-bar" d="M18 153H454M935 104H1231"/>
  </svg>
  <svg class="factory-foreground-geometry" viewBox="0 0 1320 820" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false" pointer-events="none">
   <g id={`${id}-conveyor-assembly`} transform="translate(0 80)">
   <defs><clipPath id={`${id}-factory-belt-clip`}><path d="M-160 566H921L1015 603L935 626H-160Z"/></clipPath></defs>
   <path class="factory-belt-body" d="M-160 621H935L1015 598V675L935 711H-160Z"/>
   <path class="factory-belt-endcap" d="M935 626L1015 598V675L935 711Z" fill="#10232e" stroke="#577f8e" stroke-width="2"/>
   <path class="factory-belt-surface" d="M-160 566H921L1015 603L935 626H-160Z" fill="#244856" stroke="#75a6b5" stroke-width="2"/>
   <g clip-path={`url(#${id}-factory-belt-clip)`}>
    <g class="factory-near-rail" data-factory-track="near">
     <g class="factory-belt-motion" data-factory-belt-motion stroke="#add8e1" stroke-width="2.5">
      {Array.from({length: 18}, (_, index) => <g transform={`translate(${index * 112 - 336} 0)`}>
       <path d="M0 564L35 628M56 564L91 628"/>
       <path d="M38 593H69M61 587L69 593L61 599"/>
      </g>)}
     </g>
    </g>
   </g>
   <path class="factory-belt-lip" d="M-160 560H924L1026 600L1015 607L921 573H-160ZM-160 620H935L1015 598V608L938 637H-160Z" fill="#365d6b" stroke="#83b4c0" stroke-width="1.5"/>
   <path class="factory-belt-edge" d="M-160 644H933M-160 702H933M948 643L998 624M948 690L998 668"/>
   <path class="factory-roller-axle" d="M-160 663H946" stroke="#0a1d28" stroke-width="12"/>
   {rollers.map((x, index) => <g class="factory-roller" transform={`translate(${x} 663)`}>
    <circle r="31"/><circle r="10"/>
    <path class="factory-roller-rim" d="M-22-19A29 29 0 0 1 22-19M-24 18A29 29 0 0 0 24 18" stroke="#93b9c5" stroke-width="2.5"/>
    <g class="factory-roller-spokes" style={`animation-delay:${index * -1.1}s`}><circle r="26"/><circle class="factory-spoke-key" cx="18" cy="-18" r="3" fill="#d1f7ff"/><path d="M0-26V-11M0 11V26M-26 0H-11M11 0H26M-18-18L-8-8M8 8L18 18M-18 18L-8 8M8-8L18-18"/></g>
   </g>)}
   </g>
  </svg>
  <div class="dub-reel-frames" aria-label="DubForge 制作工作区">
   {dubforgeWorkflow.map((step, index) => <figure class="dub-frame" id={`${id}-frame-${index}`} data-reel-frame={index}>
    <div class="dub-frame-view"><div class="dub-frame-camera" data-reel-camera><div class="dub-screen-bezel"><MediaImage image={step.image} zoom group={`${id}-dubforge-flow`} sizes="(max-width: 760px) calc(100vw - 54px), (max-width: 1000px) 60vw, 64vw"/></div></div></div>
    <figcaption class="dub-terminal" data-reel-console>
     <div class="dub-terminal-position"><span>工序 {String(index + 1).padStart(2, '0')}</span>{step.optional && <span class="dub-optional">按需选用</span>}</div>
     <h3>{step.title}</h3><p>{step.description}</p>
    </figcaption>
   </figure>)}
  </div>
  <nav class="dub-controls" aria-label="查看九个制作工作区">
   <p class="dub-controls-label">沿着工序，继续探索</p>
   <div class="dub-step-controls">
    {dubforgeWorkflow.map((step, index) => <button type="button" data-reel-select={index} aria-pressed={index === 0} aria-controls={`${id}-frame-${index}`} disabled>
     <span class="dub-step-number" aria-hidden="true">{String(index + 1).padStart(2,'0')}</span><span class="dub-step-name">{step.title}</span>{step.optional && <span class="dub-step-optional">可选</span>}
    </button>)}
   </div>
  </nav>
  <svg class="factory-mobile-conveyor" viewBox="0 620 1040 200" aria-hidden="true" focusable="false"><use href={`#${id}-conveyor-assembly`}/></svg>
  </div>
 </div>
 <footer class="dub-reel-end"><p>上屏评论与投稿按需要选择，每个工作区都可以单独精修。</p><p>隔离演示项目 · 自写双语稿与自绘视频，画面展示待制作状态。</p></footer>
</section>
