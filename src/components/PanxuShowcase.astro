---
import type { GalleryImage } from '../data/types';
import { getProject } from '../data/projects';
import { getProjectWorld, projectWorldStyle } from '../data/project-worlds';
import { PANXU_SHOT, PANXU_SWEEP_MS, panxuLayers, panxuPoints, panxuSteps, type PanxuRect } from '../data/panxu-showcase';
import { sitePath } from '../lib/site-path';
import Icon from './Icon.astro';
import '../styles/panxu-showcase.css';
/** detail: the opening of the 盘序 detail page, under its own h1 and summary (no heading of its own). */
interface Props { detail?: boolean }
const { detail = false } = Astro.props;
const project = getProject('panxu')!;
const world = getProjectWorld('panxu');
const image = (shot: string) => project.gallery.find(item => item.src.endsWith(`/${shot}.webp`))!;
// The same candidates and sizes everywhere: the window and every panel cut from it pick the same file.
const srcset = (item: GalleryImage) => (item.srcset ?? [...[320, 640, 960, 1600].filter(width => width < item.width)
  .map(width => `${item.src.replace(/\.webp$/, `-${width}.webp`)} ${width}w`), `${item.src} ${item.width}w`].join(', '))
  .split(',').map(candidate => { const [url, ...descriptor] = candidate.trim().split(/\s+/); return [sitePath(url), ...descriptor].join(' '); }).join(', ');
const sizes = '(max-width: 760px) 94vw, (max-width: 1340px) 90vw, 1240px';
const percent = (value: number) => `${(value * 100).toFixed(4)}%`;
function box([left, top, right, bottom]: PanxuRect, within: PanxuRect = [0, 0, PANXU_SHOT.width, PANXU_SHOT.height]) {
  const width = within[2] - within[0], height = within[3] - within[1];
  return { x: (left - within[0]) / width, y: (top - within[1]) / height, w: (right - left) / width, h: (bottom - top) / height };
}
const place = (rect: PanxuRect, within?: PanxuRect) => { const b = box(rect, within); return `--x:${percent(b.x)};--y:${percent(b.y)};--w:${percent(b.w)};--h:${percent(b.h)}`; };
// The whole screenshot inside a panel, shifted so that only the panel's own rectangle shows.
const cut = (rect: PanxuRect) => { const b = box(rect); return `width:${percent(1 / b.w)};left:${percent(-b.x / b.w)};top:${percent(-b.y / b.h)}`; };
const initial = panxuSteps.find(step => step.id === 'sort')!;
const shots = [...new Set(panxuSteps.map(step => step.shot))];
const stepOf = (id: string) => panxuSteps.find(step => step.id === id)!;
const pointOf = (group: string) => panxuPoints.find(point => point.group === group)!;
const on = (active: boolean) => active ? '' : undefined;
const callout = ({ x, top, bottom }: { x: [number, number]; top?: number; bottom?: number }) =>
  `--x:${percent(x[0] / PANXU_SHOT.width)};--w:${percent((x[1] - x[0]) / PANXU_SHOT.width)};` +
  (top !== undefined ? `top:${percent(top / PANXU_SHOT.height)}` : `bottom:${percent(1 - (bottom ?? 0) / PANXU_SHOT.height)}`);
---
<section class:list={['px-lab', { 'home-chapter': !detail, 'px-lab--detail': detail }]} id={detail ? 'panxu-checkup' : 'panxu'} data-panxu data-step={initial.id} data-shot={initial.shot} aria-labelledby={detail ? undefined : 'panxu-title'} aria-label={detail ? '一键体检演示：盘序的真实窗口' : undefined} style={`${projectWorldStyle('panxu')};--accent:${world.accent};--sweep:${PANXU_SWEEP_MS}ms`}>
 {!detail && <header class="work-heading px-heading">
  <div><h2 id="panxu-title" class="project-name" data-motion="reveal">盘序</h2><p class="px-tagline" data-motion="reveal">C 盘满了，先体检。<br/>讲清楚每一项，再决定清掉什么。</p></div>
  <div class="px-introduction"><p>下面就是盘序 1.1.0 的真实窗口，在演练环境里跑完一次一键体检。浮起来的每一块都是从这张截图上取下来的，悬停看它说了什么，点一下看原图。</p><a class="text-link" href={sitePath('/projects/panxu/')}>走进盘序 <Icon size={18}/></a></div>
 </header>}
 <div class="px-stage">
  <div class="px-rail">
   <div class="px-steps" role="group" aria-label="体检步骤">{panxuSteps.map((step, index) => <button type="button" data-px-step={step.id} data-shot={step.shot} aria-pressed={step.id === initial.id ? 'true' : 'false'}><span>{String(index + 1).padStart(2, '0')}</span>{step.label}</button>)}</div>
   <p class="px-hint">{detail ? '真实窗口 · 演练环境里的一次体检 · ' : ''}悬停浮起的部分看说明 · 点一下看原图</p>
  </div>
  <div class="px-scene" data-px-scene>
   <div class="px-float">
    <div class="px-window" data-px-window>
     <span class="px-plate" aria-hidden="true"></span>
     <span class="px-edge px-edge-r" aria-hidden="true"></span><span class="px-edge px-edge-b" aria-hidden="true"></span>
     <span class="px-shadow" aria-hidden="true"></span>
     <div class="px-titlebar">
      <span class="px-app">盘序</span><span class="px-tag">演练环境</span>
      {shots.map(shot => { const item = image(shot); return <a class="px-zoom" href={sitePath(item.src)} data-lightbox data-gallery="panxu-home" data-title={item.alt} data-caption={item.caption} data-width={item.width} data-height={item.height} data-px-zoom={shot} hidden={shot !== initial.shot}><Icon name="expand" size={15}/>看原图</a>; })}
      <span class="px-glyphs" aria-hidden="true"><i></i><i></i><i></i></span>
     </div>
     <div class="px-screen">
      {shots.map(shot => { const item = image(shot); return <img class="px-base" data-px-base={shot} data-on={on(shot === initial.shot)} aria-hidden={shot === initial.shot ? undefined : 'true'} src={sitePath(item.src)} srcset={srcset(item)} sizes={sizes} width={item.width} height={item.height} alt={item.alt} loading="lazy" decoding="async"/>; })}
      {panxuLayers.map(layer => <span class="px-socket" data-px-socket={layer.id} data-step={layer.step} data-on={on(layer.step === initial.id)} style={place(layer.rect)} aria-hidden="true"></span>)}
      {panxuLayers.map(layer => { const item = image(stepOf(layer.step).shot); const point = pointOf(layer.group); return (
       <button type="button" class="px-layer" data-px-layer={layer.id} data-step={layer.step} data-group={layer.group} data-shot={stepOf(layer.step).shot} data-tone={point.tone} data-on={on(layer.step === initial.id)} inert={layer.step !== initial.id} aria-label={`${point.label}：${point.note}点一下看原图。`} style={`${place(layer.rect)};--z:${layer.depth}px;--d:${layer.delay}ms`}>
        <span class="px-cut" aria-hidden="true"><img src={sitePath(item.src)} srcset={srcset(item)} sizes={sizes} width={item.width} height={item.height} alt="" loading="lazy" decoding="async" style={cut(layer.rect)}/></span>
        {layer.chip && <span class="px-chip" aria-hidden="true">{layer.chip}</span>}
        {layer.marker && <span class="px-marker" aria-hidden="true" style={place(layer.marker.rect, layer.rect)}><span class="px-marker-chip">{layer.marker.chip}</span></span>}
       </button>); })}
      {panxuPoints.map(point => <span class="px-callout" data-px-callout={point.group} data-step={point.step} data-tone={point.tone} data-side={point.callout.top !== undefined ? 'below' : 'above'} style={callout(point.callout)} aria-hidden="true"><b>{point.label}</b>{point.note}</span>)}
      <span class="px-sheen" aria-hidden="true"></span><span class="px-beam" aria-hidden="true"></span>
     </div>
    </div>
   </div>
  </div>
  <div class="px-copies" data-px-copies>{panxuSteps.map((step, index) => <div class="px-copy" data-px-copy={step.id} data-on={on(step.id === initial.id)} aria-hidden={step.id === initial.id ? undefined : 'true'} inert={step.id !== initial.id}>
   <div class="px-copy-lead"><p class="px-figure"><b>{step.figure}</b><small>{step.figureNote}</small></p><h3><span class="sr-only">{`第 ${index + 1} 步，${step.label}：`}</span>{step.title}</h3><p>{step.body}</p></div>
   <ul class="px-points">{panxuPoints.filter(point => point.step === step.id).map(point => <li data-px-point={point.group} data-step={point.step} data-tone={point.tone}><i aria-hidden="true"></i><b>{point.label}</b><span>{point.note}</span></li>)}</ul>
  </div>)}</div>
 </div>
</section>
