---
import { getProject } from '../data/projects';
import { getProjectWorld, projectWorldStyle } from '../data/project-worlds';
import { panxuDrawers, panxuGroups, panxuSteps, panxuDisk } from '../data/panxu-showcase';
import { sitePath } from '../lib/site-path';
import MediaImage from './MediaImage.astro';
import Icon from './Icon.astro';
import '../styles/panxu-showcase.css';
const project = getProject('panxu')!;
const world = getProjectWorld('panxu');
const shot = (name: string) => project.gallery.find(image => image.src.endsWith(`/${name}.webp`))!;
// Static first paint (and no-script reading) shows the sorted plan.
const initial = panxuSteps.findIndex(step => step.id === 'sort');
const used = panxuDisk.total - panxuDisk.freeBefore;
---
<section class="px-lab home-chapter" id="panxu" data-panxu data-step={panxuSteps[initial].id} aria-labelledby="panxu-title" style={`${projectWorldStyle('panxu')};--accent:${world.accent};--px-free:${(panxuDisk.freeBefore / panxuDisk.total * 100).toFixed(2)}%;--px-free-after:${(panxuDisk.freeAfter / panxuDisk.total * 100).toFixed(2)}%`}>
 <header class="work-heading px-heading">
  <div><h2 id="panxu-title" class="project-name" data-motion="reveal">盘序</h2><p class="px-tagline" data-motion="reveal">C 盘满了，先体检。<br/>讲清楚每一层，再决定倒掉什么。</p></div>
  <div class="px-introduction"><p>把磁盘当成一座抽屉柜：一键体检拉开每一层，分好组、写明依据，能放心清的已经勾好。下面的数字来自真实的盘序 1.1.0 在演练环境里的一次体检。</p><a class="text-link" href={sitePath('/projects/panxu/')}>走进盘序 <Icon size={18}/></a></div>
 </header>
 <div class="px-stage">
  <div class="px-scene" data-px-scene role="group" aria-label="盘序体检演示：磁盘抽屉柜">
   <div class="px-world" data-px-world>
    <div class="px-cabinet" aria-hidden="true">
     <span class="px-face px-back"></span><span class="px-face px-left"></span><span class="px-face px-right"></span><span class="px-face px-bottom"></span>
     <span class="px-face px-top"><span class="px-top-label">C:<small>{panxuDisk.total} GB</small></span></span>
     <span class="px-beam" data-px-beam></span>
    </div>
    {panxuDrawers.map((drawer, index) => <button type="button" class="px-drawer" data-px-drawer={drawer.id} data-group={drawer.group} style={`--row:${index}`} aria-label={`${drawer.name}，${drawer.size}，${panxuGroups[drawer.group].label}`} aria-controls="panxu-detail">
     <span class="px-d px-d-front" aria-hidden="true"><span class="px-d-handle"></span><span class="px-d-name">{drawer.name}</span><span class="px-d-size">{drawer.size}</span><span class="px-d-chip">{panxuGroups[drawer.group].label}</span></span>
     <span class="px-d px-d-right" aria-hidden="true"></span><span class="px-d px-d-left" aria-hidden="true"></span><span class="px-d px-d-floor" aria-hidden="true"></span><span class="px-d px-d-back" aria-hidden="true"></span>
     {drawer.files.map((group, file) => <span class="px-file" data-file-group={group} style={`--i:${file};--col:${file % 4};--lane:${Math.floor(file / 4)}`} aria-hidden="true"><span class="px-f px-f-top"></span><span class="px-f px-f-front"></span><span class="px-f px-f-right"></span></span>)}
     {drawer.id === 'junk' && <span class="px-score-card" aria-hidden="true"><b>10</b><span>分 · 建议清理</span><small>内置规则：公认可以重建的缓存</small><small>自动勾选：达到勾选门槛（5 分）</small></span>}
    </button>)}
    <span class="px-chute" aria-hidden="true"><span>回收</span></span>
   </div>
  </div>
  <div class="px-console">
   <div class="px-steps" role="group" aria-label="体检步骤">{panxuSteps.map((step, index) => <button type="button" data-px-step={step.id} aria-pressed={index === initial ? 'true' : 'false'}><span>{String(index + 1).padStart(2, '0')}</span>{step.label}</button>)}</div>
   <div class="px-gauge" aria-hidden="true"><div class="px-gauge-bar"><i></i></div><p><span>C: 可用</span><b data-px-free>{panxuDisk.freeBefore.toFixed(1)}</b><span> GB / {panxuDisk.total} GB · 已用 {used.toFixed(1)} GB</span></p></div>
   <div class="px-readout" aria-live="polite" data-px-readout>{panxuSteps.map((step, index) => <div data-px-copy={step.id} hidden={index !== initial}><p class="px-readout-number">{step.readout}<small>{step.readoutNote}</small></p><h3>{step.title}</h3><p>{step.body}</p></div>)}</div>
   <div class="px-groups" aria-hidden="true">{Object.entries(panxuGroups).map(([id, group]) => <span data-group={id}><i></i>{group.label}<b>{group.size}</b><small>{group.count}</small></span>)}</div>
   <p class="px-detail" id="panxu-detail" data-px-detail aria-live="polite">点一层抽屉，看看里面是什么。</p>
   <figure class="px-screen">{panxuSteps.map((step, index) => <div class="px-shot" data-px-shot={step.id} data-active={String(index === initial)}><MediaImage image={shot(step.shot)} sizes="(max-width: 760px) 92vw, 40vw"/></div>)}<figcaption>真实界面 · 演练环境</figcaption></figure>
  </div>
 </div>
 <script type="application/json" data-px-drawers set:html={JSON.stringify(Object.fromEntries(panxuDrawers.map(drawer => [drawer.id, { name: drawer.name, size: drawer.size, group: panxuGroups[drawer.group].label, example: drawer.example, note: drawer.note }])))}></script>
</section>
