---
import { sitePath, communityUrl } from '../lib/site-path';
import Icon from './Icon.astro';
import { projects, groups } from '../data/projects';
import { prioritizeProjects } from '../data/project-priority';
import { getProjectWorld } from '../data/project-worlds';
import '../styles/site-footer.css';
const ordered = prioritizeProjects(projects);
// Grouped by direction so the spectrum reads as four colour families.
const spectrum = groups.flatMap(group => ordered.filter(project => project.group === group.id));
const pool = ordered.map(project => sitePath(`/projects/${project.slug}/`));
---
<footer class="site-footer" data-site-footer aria-label="页尾：联系方式与全部工程">
  <div class="footer-light" data-footer-light aria-hidden="true"></div>
  <nav class="footer-spectrum" aria-label="全部工程色谱">
    {spectrum.map(project => <a href={sitePath(`/projects/${project.slug}/`)} style={`--tone:${getProjectWorld(project.slug).accent}`}><span>{project.name.split(' · ')[0]}</span></a>)}
  </nav>
  <div class="footer-inner shell">
    <div class="footer-statement">
      <a class="footer-brand" href={sitePath('/')} aria-label="返回 Liss Works 首页">
        <svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 2 30 16H16Z" fill="#fd8358"/><path d="M30 16 16 30V16Z" fill="#30aff8"/><path d="M16 30 2 16h14Z" fill="#e27ee8"/><path d="M2 16 16 2v14Z" fill="#c8ec60"/><path d="m16 10 6 6-6 6-6-6Z" fill="#080c14"/></svg>
        <span>Liss Works</span>
      </a>
      <p class="footer-line">把想法做成可以运行、可以操作、可以看见的东西。</p>
      <div class="footer-cta">
        <a class="footer-talk" href={communityUrl}><Icon name="chat" size={19}/>来聊聊 <Icon size={17}/></a>
        <button type="button" class="footer-random" data-footer-random data-pool={JSON.stringify(pool)}><Icon name="play" size={15}/>随便看一个工程</button>
      </div>
    </div>
    <nav class="footer-columns" aria-label="页尾导航">
      <div><p>作品</p><a href={sitePath('/projects/')}>工程库 <small>{projects.length}</small></a><a href={sitePath('/lab/')}>交互实验</a><a href={sitePath('/about/')}>关于 Liss</a></div>
      <div><p>方向</p>{groups.map(group => <a href={sitePath(`/projects/?group=${group.id}`)} style={`--tone:${group.tone}`}><i aria-hidden="true"></i>{group.label}</a>)}</div>
      <div><p>交流</p><a href={communityUrl}>Liss Community</a><a href="https://github.com/heroliss" target="_blank" rel="noreferrer">GitHub <Icon size={14}/></a></div>
    </nav>
  </div>
  <div class="footer-baseline shell">
    <small>© 2026 Liss · 独立开发的游戏、工具与交互实验</small>
    <a class="footer-top" href="#main">回到页首 <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20V4M6 10l6-6 6 6"/></svg></a>
  </div>
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-footer-random]').forEach(button => button.addEventListener('click', () => {
      let pool: string[] = []; try { pool = JSON.parse(button.dataset.pool ?? '[]'); } catch { pool = []; }
      const others = pool.filter(href => !location.pathname.endsWith(href.replace(/^.*?(\/projects\/)/, '$1')));
      if (others.length) location.assign(others[Math.floor(Math.random() * others.length)]);
    }));
  </script>
</footer>
