const drawing = drawings[motif];
const key = `project-field-${slug.replace(/[^a-z0-9-]/gi, '')}`;
const seed = Array.from(slug).reduce((sum, letter) => sum + letter.charCodeAt(0), 0);
const cant = ((seed % 9) - 4) * .45;
const layers = [{ name: 'upper', depth: -.35 }, { name: 'middle', depth: .55 }, { name: 'lower', depth: 1 }];
---

<div class="project-atmosphere" data-project-field data-field-family={world.family} data-field-motion={world.motion} data-field-motif={motif} aria-hidden="true" style={`--field-cant:${cant}deg;--field-accent:${world.accent};--field-surface:${world.surface}`}>
  <div class="project-atmosphere__wash"></div>
  <div class="project-atmosphere__grain"></div>
  <svg class="project-atmosphere__definitions" width="0" height="0" focusable="false">
    <defs>
      <linearGradient id={`${key}-face`} x1="100" y1="200" x2="1600" y2="900" gradientUnits="userSpaceOnUse"><stop class="field-stop-cool" stop-opacity=".14"/><stop offset=".5" class="field-stop-accent" stop-opacity=".035"/><stop offset="1" class="field-stop-warm" stop-opacity=".11"/></linearGradient>
      <linearGradient id={`${key}-edge`} x1="60" y1="400" x2="1760" y2="700" gradientUnits="userSpaceOnUse"><stop class="field-stop-cool" stop-opacity=".65"/><stop offset=".4" class="field-stop-accent" stop-opacity=".16"/><stop offset=".8" class="field-stop-warm" stop-opacity=".4"/><stop offset="1" class="field-stop-accent" stop-opacity=".08"/></linearGradient>
      <symbol id={`${key}-motif`} viewBox="0 0 1800 1200">
        <g class="detail-field-extrusion" transform="translate(0 17)">{drawing.faces.map(d => <path d={d}/>)}</g>
        <g class="detail-field-faces" fill={`url(#${key}-face)`} stroke={`url(#${key}-edge)`}>{drawing.faces.map(d => <path d={d}/>)}</g>
        <g class="detail-field-traces">{drawing.lines.map(d => <path d={d}/>)}</g>
        {drawing.rings && <g class="detail-field-rings">{drawing.rings.map(ring => <ellipse cx={ring.x} cy={ring.y} rx={ring.rx} ry={ring.ry} transform={`rotate(${ring.angle ?? 0} ${ring.x} ${ring.y})`}/>)}</g>}
        {drawing.points && <g class="detail-field-points">{drawing.points.map(point => <><ellipse cx={point.x} cy={point.y + 8} rx={point.r ?? 7} ry={(point.r ?? 7) * .62} class="detail-field-point-shadow"/><ellipse cx={point.x} cy={point.y} rx={point.r ?? 7} ry={(point.r ?? 7) * .62}/></>)}</g>}
      </symbol>
    </defs>
  </svg>
  {layers.map(layer => <div class:list={['project-atmosphere__layer', `project-atmosphere__layer--${layer.name}`]} data-detail-field-layer={layer.depth}>
    <div class="project-atmosphere__canvas"><div class="project-atmosphere__art"><svg viewBox="0 0 1800 1200" preserveAspectRatio="xMidYMid meet" fill="none" focusable="false"><use href={`#${key}-motif`} x="0" y="0" width="1800" height="1200"/></svg></div></div>
  </div>)}
</div>
