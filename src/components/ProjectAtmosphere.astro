const motif = familyMotifs[world.family] ?? ({ nodes: 'circuit', map: 'terrain', tree: 'tree', bars: 'sorting', route: 'paths', reading: 'reading', light: 'light', glyph: 'glyph', blocks: 'blocks', focus: 'focus', pipeline: 'pipeline' }[world.motion] ?? 'orbit');
