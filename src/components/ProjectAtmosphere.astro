  systems: 'pipeline', mapping: 'pipeline', glyphs: 'glyph', text: 'reading',
  journal: 'reading', desktop: 'desktop', focus: 'focus', blocks: 'blocks',
  optics: 'light', research: 'paths', paths: 'paths', routing: 'paths',
  sorting: 'sorting', evolution: 'tree',
