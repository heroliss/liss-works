---
import type { ProjectStory } from '../data/story-types';
import type { StoryMedia } from '../data/story-media';
import { getProjectWorld } from '../data/project-worlds';
import ProjectArtifact from './ProjectArtifact.astro';
import ProjectProse from './ProjectProse.astro';
import FrameworkDiagram from './FrameworkDiagram.astro';
interface Props { story: ProjectStory; media: StoryMedia[]; group: string; }
const { story, media, group } = Astro.props;
const world = getProjectWorld(group);
---
<section class="project-engineering" id="engineering" aria-labelledby="engineering-title">
  <div class="section-heading engineering-section-heading"><h2 id="engineering-title" data-detail-reveal>设计与实现</h2></div>
  <div class="engineering-grid">{story.sections?.map((section, index) => {
    const { image, inset } = media[index] ?? {};
    const copyLength = [section.intro, ...(section.paragraphs ?? []), ...(section.items?.flatMap(item => item.body) ?? [])].join('').length;
    return <section class:list={['engineering-topic', `engineering-topic--beat-${index % 3}`, {'engineering-topic--media': Boolean(image || section.diagram), 'engineering-topic--inset': Boolean(inset)}]} id={section.id} aria-labelledby={`heading-${section.id}`}>
      {section.diagram === 'framework-architecture' ? <div class="engineering-diagram" data-ui="true"><FrameworkDiagram/></div> : image && <div class="engineering-media"><figure data-detail-motion={world.motion}><ProjectArtifact image={image} kind={world.motion} role="evidence" group={group} sizes="(max-width: 900px) 100vw, 66vw"/><figcaption>{image.caption}</figcaption></figure>{inset && <figure data-detail-motion={world.motion} class:list={['engineering-inset', {'engineering-inset--strip': inset.width > inset.height * 5}]} style={`--inset-width:${inset.width}px`}><ProjectArtifact image={inset} kind={world.motion} role="inset" group={group} sizes={`${inset.width}px`}/><figcaption>{inset.caption}</figcaption></figure>}</div>}
      <div class="engineering-copy" data-copy-density={copyLength > 150 || (section.items?.length ?? 0) >= 4 ? 'long' : 'compact'}>
        <h3 class="engineering-title" id={`heading-${section.id}`} data-detail-reveal>{section.title}</h3>
        {section.intro && <ProjectProse text={section.intro} tone="lead" class="engineering-intro" reveal/>}
        {section.paragraphs?.map((paragraph, paragraphIndex) => <ProjectProse text={paragraph} tone={!section.intro && paragraphIndex === 0 ? 'lead' : 'body'} reveal/>)}
        {section.items && <dl class="engineering-points">{section.items.map(item => <div class="engineering-point" data-detail-reveal><dt><span>{item.title}</span></dt><dd>{item.body.map(paragraph => <ProjectProse text={paragraph}/>)}</dd></div>)}</dl>}
        {section.code && <div class="code-block"><div class="code-toolbar"><span>{section.code.language}</span><span role="status" aria-live="polite"></span><button class="copy-button" type="button" data-copy={`story-code-${section.id}`} aria-label={`复制：${section.title}`}>复制</button></div><pre><code id={`story-code-${section.id}`}>{section.code.source}</code></pre></div>}
        {section.code?.caption && <p class="project-caption">{section.code.caption}</p>}
      </div>
    </section>;
  })}</div>
</section>

