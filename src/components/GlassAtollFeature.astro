---
import type { Project } from '../data/types';
import { sitePath } from '../lib/site-path';
import Icon from './Icon.astro';
import AtollWaterScene from './AtollWaterScene.astro';
import '../styles/glass-atoll-feature.css';

interface Props { project: Project }
const { project } = Astro.props;
---

<section class="atoll-showcase home-chapter" id="atoll" aria-labelledby="atoll-title">
  <header class="atoll-showcase__heading">
    <div><h2 id="atoll-title" data-motion="reveal">玻璃海</h2><p class="atoll-showcase__name">Atoll · 一座实时生成的离岛</p></div>
    <div class="atoll-showcase__introduction"><p data-motion="reveal">一座岛，一片慢慢流动的海。<br/>让目光，跟着波纹慢下来。</p><a class="text-link" href={sitePath('/projects/glass-atoll/')}>走近这座岛 <Icon size={20}/></a></div>
  </header>
  <AtollWaterScene project={project}/>
</section>
