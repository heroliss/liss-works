---
import Icon from './Icon.astro';
import { projects, getProject } from '../data/projects';
import { getProjectWorld } from '../data/project-worlds';
import { sitePath } from '../lib/site-path';
import '../styles/works-spotlight.css';
// The home page introduces a few representative works; the library shows them all.
const picks = [
  { slug: 'ssframework', hook: 'Unity 游戏和工具的底层框架' },
  { slug: 'panxu', hook: '让 AI 帮你判断文件能不能删' },
  { slug: 'dubforge', hook: '把外语视频做成中文版' },
  { slug: 'glass-atoll', hook: '浏览器里就能逛的小岛' },
  { slug: 'gomoku', hook: '11 种 AI 引擎的五子棋' },
];
const featured = picks.map((pick, index) => {
  const project = getProject(pick.slug)!;
  const cover = project.cover;
  const src = sitePath(cover.srcset?.split(',').map(entry => entry.trim().split(/\s+/)).find(([, size]) => size === '960w')?.[0] ?? cover.src);
  return { ...pick, index, project, src, tone: getProjectWorld(pick.slug).accent, href: sitePath(`/projects/${pick.slug}/`), name: project.name.split(' · ')[0] };
});
// Hand-placed on the table: x, y in table pixels, a little turn, and depth order.
// Resting places on a loose ring behind the front-centre stage, where the active print stands.
const spots = [[-470, -110, -5], [-150, -300, 3], [230, -280, -3], [500, -90, 4], [-500, 160, 3]];
---
<section class="works-spotlight" id="start" data-works-spotlight data-active="0" aria-labelledby="home-title" style={`--tone:${featured[0].tone}`}>
  <canvas class="works-spotlight__canvas" data-hall-canvas aria-hidden="true" hidden></canvas>
  <div class="works-spotlight__scene" data-spotlight-scene aria-hidden="true">
    <div class="works-spotlight__plane" data-spotlight-plane>
      {featured.map((item, index) => <a class="works-spotlight__print" href={item.href} tabindex="-1" data-spotlight-print={index} data-active={index === 0 ? 'true' : undefined} style={`--tone:${item.tone};--x:${spots[index][0]}px;--y:${spots[index][1]}px;--turn:${spots[index][2]}deg;--i:${index}`}>
        <span class="works-spotlight__lift">
          <span class="works-spotlight__shot" style={`--shot:url("${item.src}")`}><img src={item.src} width={item.project.cover.width} height={item.project.cover.height} alt="" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" draggable="false"/></span>
          <span class="works-spotlight__tag"><strong>{item.name}</strong></span>
        </span>
      </a>)}
    </div>
  </div>
  <div class="works-spotlight__copy">
    <h1 id="home-title"><span>把想法，</span><span class="works-spotlight__accent">做成作品。</span></h1>
    <p class="works-spotlight__intro">我是 Liss，独立开发游戏、工具和各种交互实验。先从这五个代表作看起。</p>
    <div class="works-spotlight__card" aria-live="polite">
      <p class="works-spotlight__hook" data-spotlight-hook>{featured[0].hook}</p>
      <h2 data-spotlight-name>{featured[0].name}</h2>
      <p class="works-spotlight__summary" data-spotlight-summary>{featured[0].project.summary}</p>
      <a class="works-spotlight__enter" data-spotlight-link href={featured[0].href} data-project-enter>走进这个工程 <Icon size={18}/></a>
    </div>
    <div class="works-spotlight__picker" role="group" aria-label="选择代表作">
      {featured.map((item, index) => <button type="button" data-spotlight-pick={index} aria-pressed={index === 0} style={`--tone:${item.tone}`} data-hook={item.hook} data-name={item.name} data-summary={item.project.summary} data-href={item.href} data-image={item.src}><i aria-hidden="true"></i><span>{item.name}</span><b class="works-spotlight__timer" aria-hidden="true"></b></button>)}
    </div>
    <a class="works-spotlight__all" href={sitePath('/projects/')}>全部 {projects.length} 个工程都在工程库 <Icon size={17}/></a>
  </div>
  <p class="works-spotlight__hint" aria-hidden="true">拖动画面切换作品 · 点击进入</p>
  <a class="works-spotlight__down" href="#selected"><span>向下，看它们怎样运转</span><Icon name="down" size={17}/></a>
</section>
